# ==============================================================================
# ShenaCare AI Advisory Service Environment Configuration (services/ai)
# ==============================================================================

# Provider selection:
# - 'openrouter': production gateway. Every task goes through OpenRouter; models are chosen per task
#                 in app/llm/model_config.py (economy tier for extraction, strong tier for consultation).
# - 'groq':       legacy single-model provider (enrichment / content only; no consultation).
# - 'mock':       fully local, deterministic offline responses (no external API keys needed).
AI_PROVIDER=openrouter

# Shared secret the API must send as "Authorization: Bearer <token>" on every /v1 call (same value as the API).
# Without it the /v1 routes refuse every request. Generate with: openssl rand -hex 32
AI_SERVICE_TOKEN=

# Local development only: run /v1 without a token. Never set this on staging or production.
# AI_ALLOW_UNAUTHENTICATED=true

# Logging level: DEBUG, INFO, WARNING, ERROR
AI_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# OpenRouter (required when AI_PROVIDER=openrouter). Server-side only: never expose to a browser.
# OPEN_ROUTER_API_KEY is accepted as an alias.
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=
# 'deny' = route only to providers that do not store or train on prompts.
OPENROUTER_DATA_COLLECTION=deny
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_APP_URL=https://shinacare.com
# OPENROUTER_APP_TITLE=ShinaCare

# Model routing overrides (optional). First model = primary, the rest = fallbacks in order.
# AI_MODELS_ECONOMY=anthropic/claude-haiku-5.5,openai/gpt-6-luna,deepseek/deepseek-v4.1-flash
# AI_MODELS_STRONG=anthropic/claude-sonnet-5.5,openai/gpt-6.1-terra,google/gemini-3.8-flash
# Per-task override: models, max_tokens, temperature, timeout_s.
# AI_MODEL_CONFIG_JSON={"consult.respond":{"models":["openai/gpt-6.1-terra"],"max_tokens":1200}}

# Reliability and spend safety nets for this process (per-customer limits live in the API).
# AI_LLM_MAX_RETRIES=2
# AI_MAX_REQUESTS_PER_MINUTE=120
# AI_DAILY_COST_LIMIT_USD=10

# Groq API Key (required only if AI_PROVIDER=groq)
GROQ_API_KEY=
