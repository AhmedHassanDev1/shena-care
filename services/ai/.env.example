# ==============================================================================
# ShenaCare AI Advisory Service Environment Configuration (services/ai)
# ==============================================================================

# Provider selection:
# - 'mock': fully local, deterministic offline responses (no external API keys needed)
# - 'groq': real LLM inference using Groq API
AI_PROVIDER=mock

# Shared secret the API must send as "Authorization: Bearer <token>" on every /v1 call (same value as the API).
# Without it the /v1 routes refuse every request. Generate with: openssl rand -hex 32
AI_SERVICE_TOKEN=

# Local development only: run /v1 without a token. Never set this on staging or production.
# AI_ALLOW_UNAUTHENTICATED=true

# Logging level: DEBUG, INFO, WARNING, ERROR
AI_LOG_LEVEL=INFO

# Groq API Key (required only if AI_PROVIDER=groq)
GROQ_API_KEY=
