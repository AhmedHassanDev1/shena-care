# ==============================================================================
# ShenaCare Monorepo Root Environment Configuration Reference
# ==============================================================================
# Copy this file to `.env` or configure individual `.env` files in:
# - apps/api/.env
# - apps/web/.env.local
# - apps/business/.env.local
# - services/ai/.env
#
# ------------------------------------------------------------------------------
# 1. DATABASE (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Supabase runtime connection URL (pooled or direct with sslmode=require)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Direct PostgreSQL URL for Prisma migrations (port 5432)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# 2. API CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000,http://localhost:3020
API_URL=http://localhost:3001

# Shipment label HMAC signing key (>= 32 chars in production)
SHIPMENT_LABEL_SECRET=shena-care-dev-only-shipment-label-secret

# Delivery pricing is a JSON policy (DELIVERY_FEE_POLICY, see apps/api/.env.example); unset = the built-in default.
# ShinaCare's share of net product sales for the monthly statement, in percent (temporary 40, owner 2026-10-25).
SHINACARE_COMMISSION_PERCENT=40

# Hub coordinates
DELIVERY_HUB_LAT=29.997164
DELIVERY_HUB_LNG=31.149644

# ------------------------------------------------------------------------------
# 3. FRONTEND (Storefront & Business Workspace)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 4. STORAGE & OPTIONAL INTEGRATIONS
# ------------------------------------------------------------------------------
FILE_STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
MEDIA_STORAGE_PROVIDER=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mapbox
MAPBOX_ACCESS_TOKEN=

# AI Service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=5000
AI_PROVIDER=mock
GROQ_API_KEY=

# Optional candidate research keys (graceful rule-based fallback if unset)
EXA_API_KEY=
FIRECRAWL_API_KEY=
GROK_API_KEY=
