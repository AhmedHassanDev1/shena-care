{
  "name": "stitch-mcp-adapter",
  "version": "0.1.0",
  "private": true,
  "description": "Local stdio MCP adapter for Google's public Stitch MCP service",
  "type": "module",
  "engines": { "node": ">=20.19.0" },
  "bin": { "stitch-mcp-adapter": "dist/index.js" },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "check": "node dist/index.js --check",
    "schema": "node dist/index.js --schema",
    "test": "npm run build && node --test test/adapter.test.mjs test/stdio.test.mjs"
  },
  "dependencies": { "@modelcontextprotocol/sdk": "1.31.0", "ajv": "8.20.0" },
  "devDependencies": { "@types/node": "20.19.43", "typescript": "5.9.3" }
}
