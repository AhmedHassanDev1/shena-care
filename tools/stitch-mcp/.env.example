# Create a key in Stitch > profile > Stitch settings > API key.
STITCH_API_KEY=replace-with-your-stitch-api-key
STITCH_ENABLE_WRITES=false
STITCH_TIMEOUT_MS=300000
STITCH_DOWNLOAD_TIMEOUT_MS=30000
STITCH_MAX_DOWNLOAD_BYTES=5242880
# Alternative authentication (remove STITCH_API_KEY when using these):
# STITCH_ACCESS_TOKEN=short-lived-oauth-access-token
# GOOGLE_CLOUD_PROJECT=your-google-cloud-quota-project-id
