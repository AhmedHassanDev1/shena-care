# Postgres settings for staging
POSTGRES_DB=shenacare_staging
POSTGRES_USER=shenacare_user
POSTGRES_PASSWORD=shenacare_password

# Database URL used by Prisma
DATABASE_URL="postgresql://shenacare_user:shenacare_password@postgres:5432/shenacare_staging?schema=public"

# API environment
NODE_ENV=staging
PORT=3001
FRONTEND_URL=http://localhost:3000

# Auth Secrets (Must be changed in actual environment)
JWT_SECRET=super_secret_staging_jwt_key
SESSION_SECRET=super_secret_staging_session_key
# Shipment label HMAC key (>= 32 chars). Unset outside development/test = labels refuse to print.
SHIPMENT_LABEL_SECRET=

# External integrations
AI_SERVICE_URL=http://ai:8000
# Set both in the server copy of this file and never commit the values (openssl rand -hex 32). Without AI_SERVICE_TOKEN the AI service refuses every call.
AI_SERVICE_TOKEN=
AI_PSEUDONYM_SECRET=
AI_SERVICE_TIMEOUT_MS=10000

# Next.js web variables
NEXT_PUBLIC_API_URL=http://localhost:3001
