# ==============================================================================
# ShenaCare API Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Supabase PostgreSQL + Prisma Multi-Schema)
# ------------------------------------------------------------------------------
# Runtime connection URL:
# For Supabase connection pooler (Session mode or Transaction mode with pgbouncer):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# For direct connection (or local docker container on port 5433):
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
# ------------------------------------------------------------------------------
# 2. APPLICATION RUNTIME & SECURITY
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# Allowed CORS origins for frontend web apps (comma-separated)
FRONTEND_URL=http://localhost:3000,http://localhost:3020

# Shipment label HMAC signing key (>= 32 characters in production)
# In development/test, defaults safely to 'shena-care-dev-only-shipment-label-secret' if unset.
SHIPMENT_LABEL_SECRET=

# ------------------------------------------------------------------------------
# 3. COMMERCE & FULFILLMENT
# ------------------------------------------------------------------------------
# Base delivery fee in EGP (owner policy). Defaults to 50 EGP if unset.
DELIVERY_FEE_EGP=50

# Fulfillment hub origin coordinates (defaults: 29.997164, 31.149644)
DELIVERY_HUB_LAT=29.997164
DELIVERY_HUB_LNG=31.149644

# Mapbox Access Token (optional in dev; needed for routing calculation and route optimization)
MAPBOX_ACCESS_TOKEN=
ROUTING_PROVIDER=mapbox
ROUTE_OPTIMIZATION_PROVIDER=mapbox

# Procurement auto-batch cadence in minutes (0 = manual flush only, > 0 = automatic timer)
PROCUREMENT_BATCH_INTERVAL_MINUTES=0

# Supplier offer freshness threshold in hours (defaults to 24)
SUPPLIER_AVAILABILITY_MAX_AGE_HOURS=24

# Catalog search engine provider (defaults to 'postgres')
SEARCH_PROVIDER=postgres

# Domain events outbox polling interval in ms (defaults to 5000 in dev, 0 in test)
DOMAIN_EVENTS_POLL_MS=5000

# ------------------------------------------------------------------------------
# 4. STORAGE & MEDIA
# ------------------------------------------------------------------------------
# Storage provider for private uploads / spreadsheets ('local' supported, 's3' blocked)
FILE_STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
API_URL=http://localhost:3001

# Public media CDN ('cloudinary' or leave unset for local disk fallback)
MEDIA_STORAGE_PROVIDER=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 5. AI & INGESTION RESEARCH (Optional)
# ------------------------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=5000
ENABLE_AI_IMAGE_GENERATION=false

# Optional research enrichment keys for candidate intake (gracefully degrades to rule-based fallback if unset)
EXA_API_KEY=
FIRECRAWL_API_KEY=
GROK_API_KEY=

# Ingestion safety guard (leave false to prevent unscoped mass deactivations)
ALLOW_UNSCOPED_FULL_SNAPSHOT_DEACTIVATION=false
