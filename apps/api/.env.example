# Database
DATABASE_URL="postgresql://shenacare:shenacare@localhost:5433/shenacare?schema=public"

# Application
NODE_ENV=development
PORT=3001

# Shipment label HMAC key (>= 32 chars). Unset outside development/test = labels refuse to print.
SHIPMENT_LABEL_SECRET=

# Customer delivery fee in EGP (owner policy). Unset = provisional 50. No free-shipping threshold is implied.
DELIVERY_FEE_EGP=
