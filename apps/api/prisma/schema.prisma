generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["catalog", "commerce", "sourcing", "ingestion", "ordering", "fulfillment", "care", "accounts"]
}

// ---------------------------------------------------------------------------
// Catalog schema
// ---------------------------------------------------------------------------

model Brand {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @unique
  slug            String   @unique
  description     String?
  logoUrl         String?  @map("logo_url")
  websiteUrl      String?  @map("website_url")
  countryOfOrigin String?  @map("country_of_origin")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  products     Product[]
  productLines ProductLine[]

  @@map("brands")
  @@schema("catalog")
}

model ProductLine {
  id          String   @id @default(uuid()) @db.Uuid
  brandId     String   @map("brand_id") @db.Uuid
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([brandId])
  @@map("product_lines")
  @@schema("catalog")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId])
  @@map("categories")
  @@schema("catalog")
}

model Product {
  id            String   @id @default(uuid()) @db.Uuid
  brandId       String   @map("brand_id") @db.Uuid
  productLineId String?  @map("product_line_id") @db.Uuid
  categoryId    String?  @map("category_id") @db.Uuid
  name          String
  slug          String   @unique
  description   String?
  usage         String?
  warnings      String?
  isPublished   Boolean  @default(true) @map("is_published")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  brand               Brand                       @relation(fields: [brandId], references: [id])
  productLine         ProductLine?                @relation(fields: [productLineId], references: [id])
  category            Category?                   @relation(fields: [categoryId], references: [id])
  skus                Sku[]
  media               ProductMedia[]
  careRecommendations RoutineStepRecommendation[]

  @@index([brandId])
  @@index([productLineId])
  @@index([categoryId])
  @@map("products")
  @@schema("catalog")
}

model Sku {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  code        String   @unique
  variantName String   @map("variant_name")
  size        Decimal? @db.Decimal(10, 3)
  sizeUnit    String?  @map("size_unit")
  barcode     String?  @unique
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([barcode])
  @@map("skus")
  @@schema("catalog")
}

enum MediaType {
  image
  video

  @@schema("catalog")
}

enum MediaOriginType {
  verified // صورة من المورد أو المصنع
  generated // صورة AI
  derived // معالجة من verified (crop/bg-remove)

  @@schema("catalog")
}

model ProductMedia {
  id                 String          @id @default(uuid()) @db.Uuid
  productId          String          @map("product_id") @db.Uuid
  type               MediaType
  url                String
  altText            String?         @map("alt_text")
  sortOrder          Int             @default(0) @map("sort_order")
  isPrimary          Boolean         @default(false) @map("is_primary")
  originType         MediaOriginType @default(verified) @map("origin_type")
  generationMetadata Json?           @map("generation_metadata")
  createdAt          DateTime        @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([originType])
  @@map("product_media")
  @@schema("catalog")
}

// ---------------------------------------------------------------------------
// Commerce schema
// ---------------------------------------------------------------------------

model Listing {
  id         String    @id @default(uuid()) @db.Uuid
  skuId      String    @unique @map("sku_id") @db.Uuid
  isListed   Boolean   @default(true) @map("is_listed")
  listedAt   DateTime? @map("listed_at")
  unlistedAt DateTime? @map("unlisted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([skuId])
  @@map("listings")
  @@schema("commerce")
}

model SellingPrice {
  id              String    @id @default(uuid()) @db.Uuid
  skuId           String    @map("sku_id") @db.Uuid
  amount          Decimal   @db.Decimal(10, 2)
  currency        String    @db.VarChar(3)
  compareAtAmount Decimal?  @map("compare_at_amount") @db.Decimal(10, 2)
  validFrom       DateTime  @map("valid_from")
  validUntil      DateTime? @map("valid_until")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([skuId])
  @@index([skuId, validFrom])
  @@map("selling_prices")
  @@schema("commerce")
}

// ---------------------------------------------------------------------------
// Sourcing schema
// ---------------------------------------------------------------------------

model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  offers         SupplierOffer[]
  ingestionJobs  IngestionJob[]
  purchaseOrders SupplierPurchaseOrder[]

  @@map("suppliers")
  @@schema("sourcing")
}

model SupplierOffer {
  id              String    @id @default(uuid()) @db.Uuid
  supplierId      String    @map("supplier_id") @db.Uuid
  skuId           String    @map("sku_id") @db.Uuid
  costPrice       Decimal   @map("cost_price") @db.Decimal(10, 2)
  currency        String    @db.VarChar(3)
  isAvailable     Boolean   @default(true) @map("is_available")
  lastObservedAt  DateTime  @default(now()) @map("last_observed_at")
  lastConfirmedAt DateTime? @map("last_confirmed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, skuId])
  @@index([supplierId])
  @@index([skuId])
  @@map("supplier_offers")
  @@schema("sourcing")
}

enum PurchaseOrderStatus {
  created
  sent
  reviewed
  confirmed
  partial
  ready
  received_at_hub

  @@schema("sourcing")
}

enum PurchaseOrderLineStatus {
  pending
  confirmed_full
  confirmed_partial
  unavailable

  @@schema("sourcing")
}

model SupplierPurchaseOrder {
  id         String              @id @default(uuid()) @db.Uuid
  supplierId String              @map("supplier_id") @db.Uuid
  status     PurchaseOrderStatus @default(created)
  notes      String?
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  lines    PurchaseOrderLine[]

  @@index([supplierId])
  @@map("supplier_purchase_orders")
  @@schema("sourcing")
}

model PurchaseOrderLine {
  id                String                  @id @default(uuid()) @db.Uuid
  purchaseOrderId   String                  @map("purchase_order_id") @db.Uuid
  skuId             String                  @map("sku_id") @db.Uuid
  requestedQuantity Int                     @map("requested_quantity")
  confirmedQuantity Int?                    @map("confirmed_quantity")
  status            PurchaseOrderLineStatus @default(pending)
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  purchaseOrder SupplierPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([skuId])
  @@map("purchase_order_lines")
  @@schema("sourcing")
}

// ---------------------------------------------------------------------------
// Ordering schema
// ---------------------------------------------------------------------------

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @unique @map("session_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items CartItem[]

  @@map("carts")
  @@schema("ordering")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  skuId     String   @map("sku_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, skuId])
  @@index([cartId])
  @@index([skuId])
  @@map("cart_items")
  @@schema("ordering")
}

enum OrderStatus {
  placed
  confirmed
  packing
  shipped
  delivered
  cancelled

  @@schema("ordering")
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  orderNumber     String      @unique @map("order_number")
  customerId      String?     @map("customer_id")
  customerName    String      @map("customer_name")
  customerPhone   String      @map("customer_phone")
  shippingAddress String      @map("shipping_address")
  totalAmount     Decimal     @map("total_amount") @db.Decimal(10, 2)
  currency        String      @db.VarChar(3)
  status          OrderStatus @default(placed)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  items OrderItem[]

  @@map("orders")
  @@schema("ordering")
}

model OrderItem {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  skuId     String   @map("sku_id") @db.Uuid
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  currency  String   @db.VarChar(3)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([skuId])
  @@map("order_items")
  @@schema("ordering")
}

// ---------------------------------------------------------------------------
// Fulfillment schema
// ---------------------------------------------------------------------------

model FulfillmentLocation {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  address   String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shipments Shipment[]

  @@map("fulfillment_locations")
  @@schema("fulfillment")
}

enum ShipmentStatus {
  pending
  ready_to_prepare
  preparing
  prepared
  ready_to_pack
  packing
  packed
  dispatched
  out_for_delivery
  delivered
  failed
  returned

  @@schema("fulfillment")
}

model Shipment {
  id             String         @id @default(uuid()) @db.Uuid
  orderId        String         @unique @map("order_id") @db.Uuid
  locationId     String         @map("location_id") @db.Uuid
  status         ShipmentStatus @default(pending)
  trackingNumber String?        @map("tracking_number")
  dispatchedAt   DateTime?      @map("dispatched_at")
  deliveredAt    DateTime?      @map("delivered_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  location FulfillmentLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  items    ShipmentItem[]
  preparationSessions ShipmentPreparationSession[]
  events   ShipmentEvent[]

  deliveryBatchId String? @map("delivery_batch_id") @db.Uuid
  deliveryBatch   DeliveryBatch? @relation(fields: [deliveryBatchId], references: [id])

  @@index([locationId])
  @@map("shipments")
  @@schema("fulfillment")
}

model ShipmentItem {
  id         String   @id @default(uuid()) @db.Uuid
  shipmentId String   @map("shipment_id") @db.Uuid
  skuId      String   @map("sku_id") @db.Uuid
  quantity   Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([skuId])
  @@map("shipment_items")
  @@schema("fulfillment")
}

model DeliveryBatch {
  id           String    @id @default(uuid()) @db.Uuid
  status       String    @default("planned") // planned, dispatched, completed
  driverId     String?   @map("driver_id")
  plannedAt    DateTime? @default(now()) @map("planned_at")
  dispatchedAt DateTime? @map("dispatched_at")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  shipments    Shipment[]

  @@map("delivery_batches")
  @@schema("fulfillment")
}

model ShipmentEvent {
  id         String    @id @default(uuid()) @db.Uuid
  shipmentId String    @map("shipment_id") @db.Uuid
  type       String    // e.g. PACKED, LABEL_PRINTED, HANDOFF_SCANNED, OUT_FOR_DELIVERY, DELIVERED, FAILED, RETURNED
  actorId    String?   @map("actor_id") // ID of hub operator or driver
  notes      String?
  createdAt  DateTime  @default(now()) @map("created_at")

  shipment   Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("shipment_events")
  @@schema("fulfillment")
}

enum PreparationSessionStatus {
  in_progress
  completed
  failed

  @@schema("fulfillment")
}

model ShipmentPreparationSession {
  id           String    @id @default(uuid()) @db.Uuid
  shipmentId   String    @map("shipment_id") @db.Uuid
  operatorId   String    @map("operator_id") // Optional UUID or username representing the hub operator
  startedAt    DateTime  @default(now()) @map("started_at")
  completedAt  DateTime? @map("completed_at")
  status       PreparationSessionStatus @default(in_progress)
  
  shipment     Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  scanEvents   PreparationScanEvent[]

  @@index([shipmentId])
  @@map("shipment_preparation_sessions")
  @@schema("fulfillment")
}

model PreparationScanEvent {
  id             String    @id @default(uuid()) @db.Uuid
  sessionId      String    @map("session_id") @db.Uuid
  skuId          String?   @map("sku_id") @db.Uuid
  barcodeScanned String?   @map("barcode_scanned")
  scannedAt      DateTime  @default(now()) @map("scanned_at")
  isSuccessful   Boolean   @default(true) @map("is_successful")
  errorReason    String?   @map("error_reason")
  
  session        ShipmentPreparationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("preparation_scan_events")
  @@schema("fulfillment")
}

// ---------------------------------------------------------------------------
// Ingestion schema (B6)
// ---------------------------------------------------------------------------

enum IngestionStatus {
  pending
  review_required
  approved
  rejected
  published

  @@schema("ingestion")
}

model IngestionJob {
  id         String          @id @default(uuid()) @db.Uuid
  supplierId String          @map("supplier_id") @db.Uuid
  status     IngestionStatus @default(pending)
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  items    IngestionItem[]
  supplier Supplier        @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@map("ingestion_jobs")
  @@schema("ingestion")
}

enum IngestionItemEnrichmentStatus {
  pending
  succeeded
  failed

  @@schema("ingestion")
}

model IngestionItem {
  id               String                        @id @default(uuid()) @db.Uuid
  jobId            String                        @map("job_id") @db.Uuid
  supplierSkuCode  String                        @map("supplier_sku_code")
  name             String
  brand            String
  barcode          String?
  price            Decimal                       @db.Decimal(10, 2)
  currency         String                        @db.VarChar(3)
  status           IngestionStatus               @default(pending)
  matchedSkuId     String?                       @map("matched_sku_id") @db.Uuid
  enrichmentStatus IngestionItemEnrichmentStatus @default(pending) @map("enrichment_status")
  enrichment       Json?
  enrichmentError  String?                       @map("enrichment_error")
  createdAt        DateTime                      @default(now()) @map("created_at")
  updatedAt        DateTime                      @updatedAt @map("updated_at")

  job IngestionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([status])
  @@map("ingestion_items")
  @@schema("ingestion")
}

// ---------------------------------------------------------------------------
// Care schema
// ---------------------------------------------------------------------------

enum CareArea {
  skin
  hair

  @@schema("care")
}

enum RoutineTiming {
  am
  pm
  both
  as_needed

  @@schema("care")
}

model Concern {
  id          String                       @id @default(uuid()) @db.Uuid
  careArea    CareArea                     @map("care_area")
  name        String                       @unique
  slug        String                       @unique
  description String?
  isActive    Boolean                      @default(true) @map("is_active")
  createdAt   DateTime                     @default(now()) @map("created_at")
  updatedAt   DateTime                     @updatedAt @map("updated_at")
  profiles    CustomerCareProfileConcern[]

  @@map("concerns")
  @@schema("care")
}

model Routine {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?
  careArea    CareArea @map("care_area")
  isTemplate  Boolean  @default(true) @map("is_template")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  steps    RoutineStep[]
  profiles CustomerCareProfile[]

  @@map("routines")
  @@schema("care")
}

model RoutineStep {
  id           String        @id @default(uuid()) @db.Uuid
  routineId    String        @map("routine_id") @db.Uuid
  title        String
  instructions String?
  stepOrder    Int           @map("step_order")
  timing       RoutineTiming
  isOptional   Boolean       @default(false) @map("is_optional")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  routine         Routine                     @relation(fields: [routineId], references: [id], onDelete: Cascade)
  recommendations RoutineStepRecommendation[]

  @@unique([routineId, stepOrder])
  @@index([routineId])
  @@map("routine_steps")
  @@schema("care")
}

enum RecommendationSource {
  manual
  rule_engine
  ai
  expert

  @@schema("care")
}

model RoutineStepRecommendation {
  id        String               @id @default(uuid()) @db.Uuid
  stepId    String               @map("step_id") @db.Uuid
  productId String               @map("product_id") @db.Uuid
  source    RecommendationSource @default(manual)
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  step    RoutineStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([stepId, productId])
  @@index([stepId])
  @@index([productId])
  @@map("routine_step_recommendations")
  @@schema("care")
}

enum SkinType {
  normal
  dry
  oily
  combination
  sensitive

  @@schema("care")
}

model CustomerCareProfile {
  id            String    @id @default(uuid()) @db.Uuid
  customerId    String    @unique @map("customer_id")
  skinType      SkinType? @map("skin_type")
  budget        Decimal?  @db.Decimal(10, 2)
  currency      String?   @db.VarChar(3)
  sensitivities String?
  routineId     String?   @map("routine_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  routine  Routine?                     @relation(fields: [routineId], references: [id])
  concerns CustomerCareProfileConcern[]

  @@index([routineId])
  @@map("customer_care_profiles")
  @@schema("care")
}

model CustomerCareProfileConcern {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  concernId String   @map("concern_id") @db.Uuid
  severity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  profile CustomerCareProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  concern Concern             @relation(fields: [concernId], references: [id], onDelete: Cascade)

  @@unique([profileId, concernId])
  @@index([profileId])
  @@index([concernId])
  @@map("customer_care_profile_concerns")
  @@schema("care")
}

enum GuidanceSessionStatus {
  active
  completed
  abandoned

  @@schema("care")
}

model GuidanceSession {
  id         String                @id @default(uuid()) @db.Uuid
  customerId String                @map("customer_id")
  status     GuidanceSessionStatus @default(active)
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  messages GuidanceMessage[]

  @@index([customerId])
  @@map("guidance_sessions")
  @@schema("care")
}

enum GuidanceMessageRole {
  user
  assistant
  system

  @@schema("care")
}

model GuidanceMessage {
  id        String              @id @default(uuid()) @db.Uuid
  sessionId String              @map("session_id") @db.Uuid
  role      GuidanceMessageRole
  content   String
  proposal  Json? // Store structured routine proposal if returned by AI
  createdAt DateTime            @default(now()) @map("created_at")

  session GuidanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("guidance_messages")
  @@schema("care")
}

// ---------------------------------------------------------------------------
// Accounts schema
// ---------------------------------------------------------------------------

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  identities Identity[]
  sessions   Session[]

  @@map("customers")
  @@schema("accounts")
}

model Identity {
  id           String   @id @default(uuid()) @db.Uuid
  customerId   String   @map("customer_id") @db.Uuid
  provider     String // e.g., 'EMAIL', 'GOOGLE'
  providerId   String   @map("provider_id") // e.g., email address
  passwordHash String?  @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([customerId])
  @@map("identities")
  @@schema("accounts")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  token      String   @unique @db.Uuid
  isValid    Boolean  @default(true) @map("is_valid")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([token])
  @@map("sessions")
  @@schema("accounts")
}
