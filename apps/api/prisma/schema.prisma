generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["catalog", "commerce"]
}

// ---------------------------------------------------------------------------
// Catalog schema
// ---------------------------------------------------------------------------

model Brand {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  logoUrl     String?  @map("logo_url")
  websiteUrl  String?  @map("website_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("brands")
  @@schema("catalog")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  brandId     String   @map("brand_id") @db.Uuid
  name        String
  slug        String   @unique
  description String?
  usage       String?
  warnings    String?
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  brand Brand          @relation(fields: [brandId], references: [id])
  skus  Sku[]
  media ProductMedia[]

  @@index([brandId])
  @@map("products")
  @@schema("catalog")
}

model Sku {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  code        String   @unique
  variantName String   @map("variant_name")
  size        Decimal? @db.Decimal(10, 3)
  sizeUnit    String?  @map("size_unit")
  barcode     String?  @unique
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([barcode])
  @@map("skus")
  @@schema("catalog")
}

enum MediaType {
  image
  video

  @@schema("catalog")
}

model ProductMedia {
  id        String    @id @default(uuid()) @db.Uuid
  productId String    @map("product_id") @db.Uuid
  type      MediaType
  url       String
  altText   String?   @map("alt_text")
  sortOrder Int       @default(0) @map("sort_order")
  isPrimary Boolean   @default(false) @map("is_primary")
  createdAt DateTime  @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("product_media")
  @@schema("catalog")
}

// ---------------------------------------------------------------------------
// Commerce schema
// ---------------------------------------------------------------------------

model Listing {
  id         String    @id @default(uuid()) @db.Uuid
  skuId      String    @unique @map("sku_id") @db.Uuid
  isListed   Boolean   @default(true) @map("is_listed")
  listedAt   DateTime? @map("listed_at")
  unlistedAt DateTime? @map("unlisted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([skuId])
  @@map("listings")
  @@schema("commerce")
}

model SellingPrice {
  id               String    @id @default(uuid()) @db.Uuid
  skuId            String    @map("sku_id") @db.Uuid
  amount           Decimal   @db.Decimal(10, 2)
  currency         String    @db.VarChar(3)
  compareAtAmount  Decimal?  @map("compare_at_amount") @db.Decimal(10, 2)
  validFrom        DateTime  @map("valid_from")
  validUntil       DateTime? @map("valid_until")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([skuId])
  @@index([skuId, validFrom])
  @@map("selling_prices")
  @@schema("commerce")
}
