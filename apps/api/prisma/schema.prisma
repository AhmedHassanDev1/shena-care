generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["catalog", "commerce", "sourcing", "ingestion", "ordering", "fulfillment", "care", "accounts", "operations"]
}

// ---------------------------------------------------------------------------
// Catalog schema
// ---------------------------------------------------------------------------

model Brand {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @unique
  slug            String   @unique
  description     String?
  logoUrl         String?  @map("logo_url")
  logoMetadata    Json?    @map("logo_metadata")
  websiteUrl      String?  @map("website_url")
  countryOfOrigin String?  @map("country_of_origin")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  products     Product[]
  productLines ProductLine[]

  @@map("brands")
  @@schema("catalog")
}

model ProductLine {
  id            String   @id @default(uuid()) @db.Uuid
  brandId       String   @map("brand_id") @db.Uuid
  name          String
  slug          String   @unique
  description   String?
  imageUrl      String?  @map("image_url")
  imageMetadata Json?    @map("image_metadata")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([brandId])
  @@map("product_lines")
  @@schema("catalog")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId])
  @@map("categories")
  @@schema("catalog")
}

model Product {
  id            String   @id @default(uuid()) @db.Uuid
  brandId       String   @map("brand_id") @db.Uuid
  productLineId String?  @map("product_line_id") @db.Uuid
  categoryId    String?  @map("category_id") @db.Uuid
  name          String
  slug          String   @unique
  description   String?
  usage         String?
  warnings      String?
  concerns      String[] @default([])
  targetArea    UsageTargetArea? @map("target_area")
  texture       ProductTexture?
  suitableSkinTypes String[] @default([]) @map("suitable_skin_types")
  suitableHairTypes String[] @default([]) @map("suitable_hair_types")
  spf           Int?
  broadSpectrum Boolean? @map("broad_spectrum")
  uvFilterType  UvFilterType? @map("uv_filter_type")
  waterResistanceMinutes Int? @map("water_resistance_minutes")
  isFragranceFree  Boolean? @map("is_fragrance_free")
  isNonComedogenic Boolean? @map("is_non_comedogenic")
  /// Evidence provenance for claims (fragrance-free, non-comedogenic, etc.)
  claimsEvidence   Json?    @map("claims_evidence")
  factVersion   Int      @default(1) @map("fact_version")
  lastReviewedAt DateTime? @map("last_reviewed_at")
  lastReviewedBy String? @map("last_reviewed_by")
  isPublished   Boolean  @default(false) @map("is_published")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  brand               Brand                       @relation(fields: [brandId], references: [id])
  productLine         ProductLine?                @relation(fields: [productLineId], references: [id])
  category            Category?                   @relation(fields: [categoryId], references: [id])
  skus                Sku[]
  media               ProductMedia[]
  careRecommendations RoutineStepRecommendation[]
  productIngredients  ProductIngredient[]
  usageRules          ProductUsageRule[]
  safetyWarnings      ProductSafetyWarning[]

  @@index([brandId])
  @@index([productLineId])
  @@index([categoryId])
  @@index([targetArea])
  @@index([texture])
  @@map("products")
  @@schema("catalog")
}

model Sku {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  code        String   @unique
  variantName String   @map("variant_name")
  size        Decimal? @db.Decimal(10, 3)
  sizeUnit    String?  @map("size_unit")
  packCount   Int?     @map("pack_count")
  barcode     String?  @unique
  estimatedDaysOfUse Int? @map("estimated_days_of_use")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product            Product            @relation(fields: [productId], references: [id])
  supplierSkuAliases SupplierSkuAlias[]
  barcodeAliases     SkuBarcodeAlias[]
  productIngredients ProductIngredient[]
  usageRules         ProductUsageRule[]
  safetyWarnings     ProductSafetyWarning[]

  @@index([productId])
  @@index([barcode])
  @@map("skus")
  @@schema("catalog")
}

enum BarcodeAliasStatus {
  approved
  retired

  @@schema("catalog")
}

/// A reviewed additional manufacturer barcode for the SAME canonical SKU (packaging revision,
/// legacy stock), GLO-242. Approved only by a catalog reviewer with evidence; never inferred from a
/// scan or a supplier. One code resolving to two SKUs is ambiguous and blocks scanning.
model SkuBarcodeAlias {
  id          String             @id @default(uuid()) @db.Uuid
  barcode     String             @db.VarChar(64)
  skuId       String             @map("sku_id") @db.Uuid
  status      BarcodeAliasStatus @default(approved)
  /// packaging_revision | legacy_stock | manufacturer_list | other
  source      String             @db.VarChar(40)
  evidenceRef String?            @map("evidence_ref") @db.VarChar(255)
  reason      String
  approvedBy  String             @map("approved_by")
  approvedAt  DateTime           @default(now()) @map("approved_at")
  retiredBy   String?            @map("retired_by")
  retiredAt   DateTime?          @map("retired_at")

  sku Sku @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@unique([barcode, skuId])
  @@index([barcode])
  @@map("sku_barcode_aliases")
  @@schema("catalog")
}

enum MediaType {
  image
  video

  @@schema("catalog")
}

enum MediaOriginType {
  verified // صورة من المورد أو المصنع
  generated // صورة AI
  derived // معالجة من verified (crop/bg-remove)

  @@schema("catalog")
}

model ProductMedia {
  id                 String          @id @default(uuid()) @db.Uuid
  productId          String          @map("product_id") @db.Uuid
  type               MediaType
  url                String
  altText            String?         @map("alt_text")
  sortOrder          Int             @default(0) @map("sort_order")
  isPrimary          Boolean         @default(false) @map("is_primary")
  originType         MediaOriginType @default(verified) @map("origin_type")
  generationMetadata Json?           @map("generation_metadata")
  createdAt          DateTime        @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([originType])
  @@map("product_media")
  @@schema("catalog")
}

model Ingredient {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String              @unique
  nameAr             String?             @map("name_ar")
  slug               String              @unique
  inciName           String              @map("inci_name")
  aliases            String[]            @default([])
  family             String?             // e.g. "Vitamin C", "Retinoids", "Hydroxy Acids"
  familySlug         String?             @map("family_slug")
  chemicalForm       String?             @map("chemical_form") // e.g. "Pure Acid", "Ester", "Salt", "Glycoside"
  primaryFunction    String              @map("primary_function") // "Antioxidant", "Humectant", "Exfoliant", "Barrier Support", "Skin Restoring", "Vehicle", "Preservative"
  functions          String[]            @default([])
  isActiveIngredient Boolean             @default(false) @map("is_active_ingredient")
  rating             String?             // "BEST", "GOOD", "AVERAGE"
  descriptionEn      String?             @map("description_en")
  descriptionAr      String?             @map("description_ar")
  benefits           Json?               // Array of { concern: string, description: string, evidenceLevel: string, pubmedRef?: string }
  cautions           String[]            @default([])
  contraindications  String[]            @default([]) // e.g. ["PREGNANCY", "COMPROMISED_BARRIER"]
  visualStatus       String              @default("NOT_GENERATED") @map("visual_status")
  visualUrl          String?             @map("visual_url")
  visualMetadata     Json?               @map("visual_metadata")
  status             String              @default("APPROVED")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  productIngredients ProductIngredient[]

  @@index([familySlug])
  @@index([inciName])
  @@index([isActiveIngredient])
  @@map("ingredients")
  @@schema("catalog")
}

model ProductIngredient {
  id            String     @id @default(uuid()) @db.Uuid
  productId     String     @map("product_id") @db.Uuid
  skuId         String?    @map("sku_id") @db.Uuid
  ingredientId  String     @map("ingredient_id") @db.Uuid
  isKeyActive   Boolean    @default(false) @map("is_key_active")
  concentration String?    // e.g. "10%", "2%" - only when verified, never assumed
  /// Typed concentration explicitly stated by the manufacturer/label for THIS product (GLO-279); never inferred.
  concentrationValue    Decimal? @map("concentration_value") @db.Decimal(7, 3)
  concentrationUnit     String?  @map("concentration_unit") @db.VarChar(10)
  /// { sourceUrl, sourceType, evidenceText, reviewedBy, reviewedAt } for the stated concentration.
  concentrationEvidence Json?    @map("concentration_evidence")
  concentrationStatus   ConcentrationStatus @default(UNKNOWN) @map("concentration_status")
  sortOrder     Int        @default(0) @map("sort_order")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        Sku?       @relation(fields: [skuId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientId, skuId])
  @@index([productId])
  @@index([skuId])
  @@index([ingredientId])
  @@map("product_ingredients")
  @@schema("catalog")
}

enum ProductTexture {
  GEL
  CREAM
  GEL_CREAM
  LOTION
  EMULSION
  SERUM
  OIL
  BALM
  FOAM
  LIQUID
  SPRAY
  PASTE
  STICK
  POWDER

  @@schema("catalog")
}

enum UvFilterType {
  MINERAL
  CHEMICAL
  HYBRID

  @@schema("catalog")
}


enum ConcentrationStatus {
  STATED          /// Manufacturer/label explicitly states a value
  UNDISCLOSED     /// Present but amount not published
  NOT_APPLICABLE  /// Not meaningful for this ingredient role
  UNKNOWN         /// Not yet evaluated

  @@schema("catalog")
}

enum SafetyWarningKind {
  CONTRAINDICATION
  INTERACTION
  RESTRICTION
  ESCALATION
  PRECAUTION

  @@schema("catalog")
}

/// A structured safety warning for a product, with evidence (GLO-284 §4D).
/// Distinguishes ingredient-level cautions from finished-product safety facts.
model ProductSafetyWarning {
  id            String            @id @default(uuid()) @db.Uuid
  productId     String            @map("product_id") @db.Uuid
  skuId         String?           @map("sku_id") @db.Uuid
  kind          SafetyWarningKind
  condition     String?           @db.VarChar(80)  /// e.g. "PREGNANT", "COMPROMISED_BARRIER"
  descriptionEn String            @map("description_en")
  descriptionAr String?           @map("description_ar")
  sourceType    String            @map("source_type") @db.VarChar(40)
  sourceUrl     String?           @map("source_url")
  reviewedBy    String            @map("reviewed_by")
  reviewedAt    DateTime          @map("reviewed_at")
  isActive      Boolean           @default(true) @map("is_active")
  createdAt     DateTime          @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku     Sku?    @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([skuId])
  @@index([condition])
  @@map("product_safety_warnings")
  @@schema("catalog")
}

enum UsageTargetArea {
  FACE
  EYE_CONTOUR
  LIPS
  BODY
  SCALP
  HAIR

  @@schema("catalog")
}

enum UsageRoutinePeriod {
  AM
  PM
  BOTH
  UNKNOWN

  @@schema("catalog")
}

enum UsageRinseMode {
  RINSE_OFF
  LEAVE_ON
  UNKNOWN

  @@schema("catalog")
}

enum UsageFrequencyUnit {
  DAY
  WEEK
  AS_NEEDED
  UNKNOWN

  @@schema("catalog")
}

/// A reviewer-confirmed usage instruction for a product (optionally one SKU), taken from the product's own directions
/// with its evidence (GLO-279). A product can have several conditional rules (face vs scalp, introductory vs regular);
/// anything the directions do not state stays UNKNOWN/null — never filled from the product type.
model ProductUsageRule {
  id                String             @id @default(uuid()) @db.Uuid
  productId         String             @map("product_id") @db.Uuid
  skuId             String?            @map("sku_id") @db.Uuid
  targetArea        UsageTargetArea?   @map("target_area")
  routinePeriod     UsageRoutinePeriod @map("routine_period")
  rinseMode         UsageRinseMode     @map("rinse_mode")
  frequencyUnit     UsageFrequencyUnit @map("frequency_unit")
  usesMin           Int?               @map("uses_min")
  usesMax           Int?               @map("uses_max")
  /// Recommended application amount and unit (e.g. 2 drops, 1 pea-sized, 5 ml); null if not stated.
  applicationQuantity Decimal?         @map("application_quantity") @db.Decimal(7, 3)
  applicationUnit   String?            @map("application_unit") @db.VarChar(30)
  contactMinutes    Int?               @map("contact_minutes")
  contactIsMaximum  Boolean            @default(false) @map("contact_is_maximum")
  /// Free-form condition label, e.g. "introductory", "maintenance", "flare", "sun_exposure"
  condition         String?            @db.VarChar(40)
  /// Whether this rule is for an introductory/escalation phase (true) versus the regular regimen (false).
  isIntroductory    Boolean            @default(false) @map("is_introductory")
  /// Ordering of phases when the product has introductory escalation: 1 = first phase, 2 = next, etc.
  phaseOrder        Int?               @map("phase_order")
  /// Minimum weeks before transitioning to the next phase (null = not specified).
  phaseWeeksMin     Int?               @map("phase_weeks_min")
  /// Maximum weeks this phase should last (null = indefinite or not specified).
  phaseWeeksMax     Int?               @map("phase_weeks_max")
  evidenceText      String             @map("evidence_text")
  sourceUrl         String             @map("source_url")
  sourceType        String             @map("source_type") @db.VarChar(40)
  retrievedAt       DateTime?          @map("retrieved_at")
  reviewedBy        String             @map("reviewed_by")
  reviewedAt        DateTime           @map("reviewed_at")
  sourceCandidateId String?            @map("source_candidate_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku     Sku?    @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([skuId])
  @@map("product_usage_rules")
  @@schema("catalog")
}

// ---------------------------------------------------------------------------
// Commerce schema
// ---------------------------------------------------------------------------

model Listing {
  id         String    @id @default(uuid()) @db.Uuid
  skuId      String    @unique @map("sku_id") @db.Uuid
  isListed   Boolean   @default(true) @map("is_listed")
  listedAt   DateTime? @map("listed_at")
  unlistedAt DateTime? @map("unlisted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([skuId])
  @@map("listings")
  @@schema("commerce")
}

model SellingPrice {
  id              String    @id @default(uuid()) @db.Uuid
  skuId           String    @map("sku_id") @db.Uuid
  amount          Decimal   @db.Decimal(10, 2)
  currency        String    @db.VarChar(3)
  compareAtAmount Decimal?  @map("compare_at_amount") @db.Decimal(10, 2)
  validFrom       DateTime  @map("valid_from")
  validUntil      DateTime? @map("valid_until")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([skuId])
  @@index([skuId, validFrom])
  @@map("selling_prices")
  @@schema("commerce")
}

enum BenefitType {
  item_discount
  order_discount
  free_shipping

  @@schema("commerce")
}

enum DiscountType {
  percentage
  fixed_amount

  @@schema("commerce")
}

model Promotion {
  id             String        @id @default(uuid()) @db.Uuid
  campaignName   String        @map("campaign_name")
  code           String?       @unique // Optional manual coupon code
  benefitType    BenefitType   @map("benefit_type")
  discountType   DiscountType? @map("discount_type") // For item/order discounts
  discountValue  Decimal?      @map("discount_value") @db.Decimal(10, 2) // % or fixed amount
  minBasketValue Decimal?      @map("min_basket_value") @db.Decimal(10, 2) // e.g. for free shipping threshold
  isStackable    Boolean       @default(false) @map("is_stackable")
  isActive       Boolean       @default(true) @map("is_active")
  validFrom      DateTime      @map("valid_from")
  validUntil     DateTime?     @map("valid_until")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@map("promotions")
  @@schema("commerce")
}

// ---------------------------------------------------------------------------
// Sourcing schema
// ---------------------------------------------------------------------------

model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  /// Days the warehouse is closed (0 = Sunday … 6 = Saturday); Friday by default.
  closedWeekdays Int[]   @default([5]) @map("closed_weekdays")
  closedDates String[]   @default([]) @map("closed_dates")
  /// Staff-verified preparation, pickup and onward delivery lead; null uses a conservative operational estimate with uncertainty.
  pickupLeadMinutes Int? @map("pickup_lead_minutes")
  /// Working hours "HH:MM" in the configured supplier timezone; empty uses the configured defaults.
  opensAt   String?  @map("opens_at") @db.VarChar(5)
  closesAt  String?  @map("closes_at") @db.VarChar(5)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  offers         SupplierOffer[]
  ingestionJobs  IngestionJob[]
  purchaseOrders SupplierPurchaseOrder[]
  payables       SupplierPayable[]
  skuAliases     SupplierSkuAlias[]
  accounts       Customer[]
  exportProfiles ExportProfile[]

  @@map("suppliers")
  @@schema("sourcing")
}

model SupplierSkuAlias {
  id              String   @id @default(uuid()) @db.Uuid
  supplierId      String   @map("supplier_id") @db.Uuid
  supplierSkuCode String   @map("supplier_sku_code")
  skuId           String   @map("sku_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  sku      Sku      @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([supplierId, supplierSkuCode])
  @@index([supplierId])
  @@index([skuId])
  @@map("supplier_sku_aliases")
  @@schema("sourcing")
}

model SupplierOffer {
  id              String    @id @default(uuid()) @db.Uuid
  supplierId      String    @map("supplier_id") @db.Uuid
  skuId           String    @map("sku_id") @db.Uuid
  costPrice       Decimal   @map("cost_price") @db.Decimal(10, 2)
  currency        String    @db.VarChar(3)
  isAvailable     Boolean   @default(true) @map("is_available")
  lastObservedAt  DateTime  @default(now()) @map("last_observed_at")
  lastIngestionItemId String? @map("last_ingestion_item_id") @db.Uuid
  lastConfirmedAt DateTime? @map("last_confirmed_at")
  /// Quantity the supplier says it can supply now; null = not reported (yes/no availability only).
  availableQuantity Int?    @map("available_quantity")
  quantityUpdatedAt DateTime? @map("quantity_updated_at")
  /// PO shortage evidence; does not rewrite the supplier's physical stock snapshot.
  shortageObservedAt DateTime? @map("shortage_observed_at")
  minimumOrderUnits Int @default(1) @map("minimum_order_units")
  orderMultipleUnits Int @default(1) @map("order_multiple_units")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  supplier          Supplier           @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  sourceAllocations SourceAllocation[]

  @@unique([supplierId, skuId])
  @@index([supplierId])
  @@index([skuId])
  @@map("supplier_offers")
  @@schema("sourcing")
}

model SourcingDecision {
  id String @id @default(uuid()) @db.Uuid
  skuId String @map("sku_id") @db.Uuid
  requiredQuantity Int @map("required_quantity")
  requirementId String? @map("requirement_id") @db.Uuid
  rankedOffers Json @map("ranked_offers")
  excludedOffers Json @map("excluded_offers")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([requirementId, createdAt])
  @@index([skuId, createdAt])
  @@map("sourcing_decisions")
  @@schema("sourcing")
}

enum SupplyPlanStatus {
  CONFIRMING
  COVERED
  PARTIALLY_UNAVAILABLE
  UNAVAILABLE

  @@schema("sourcing")
}

enum SourceConfirmationResult {
  pending
  confirmed_full
  confirmed_partial
  unavailable
  rejected
  price_changed

  @@schema("sourcing")
}

model SupplyRequest {
  id        String           @id @default(uuid()) @db.Uuid
  orderId   String           @unique @map("order_id") @db.Uuid
  status    SupplyPlanStatus @default(CONFIRMING)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  requirements SupplyRequirement[]
  events       SupplyPlanEvent[]

  @@map("supply_requests")
  @@schema("sourcing")
}

model SupplyRequirement {
  id               String    @id @default(uuid()) @db.Uuid
  supplyRequestId  String    @map("supply_request_id") @db.Uuid
  orderItemId      String    @unique @map("order_item_id") @db.Uuid
  skuId            String    @map("sku_id") @db.Uuid
  requiredQuantity Int       @map("required_quantity")
  orderSnapshotRef String    @map("order_snapshot_ref") @db.Uuid
  releasedAt       DateTime? @map("released_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  supplyRequest     SupplyRequest                  @relation(fields: [supplyRequestId], references: [id], onDelete: Cascade)
  allocations       SourceAllocation[]
  actionRequirement AvailabilityActionRequirement?

  @@index([supplyRequestId])
  @@map("supply_requirements")
  @@schema("sourcing")
}

model SourceAllocation {
  id                String                    @id @default(uuid()) @db.Uuid
  requirementId     String                    @map("requirement_id") @db.Uuid
  supplierOfferId   String                    @map("supplier_offer_id") @db.Uuid
  requestedQuantity Int                       @map("requested_quantity")
  allocatedQuantity Int                       @map("allocated_quantity")
  confirmedQuantity Int                       @default(0) @map("confirmed_quantity")
  selectedCost      Decimal                   @map("selected_cost") @db.Decimal(10, 2)
  selectedCurrency  String                    @map("selected_currency") @db.VarChar(3)
  rankingDecisionId String                    @map("ranking_decision_id") @db.Uuid
  result            SourceConfirmationResult  @default(pending)
  reportedResult    SourceConfirmationResult? @map("reported_result")
  reportedQuantity  Int?                      @map("reported_quantity")
  selectedAt        DateTime                  @default(now()) @map("selected_at")
  confirmedAt       DateTime?                 @map("confirmed_at")
  evidenceRef       String?                   @map("evidence_ref") @db.VarChar(255)

  requirement   SupplyRequirement            @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  supplierOffer SupplierOffer                @relation(fields: [supplierOfferId], references: [id])
  poLink        PurchaseOrderLineAllocation?

  @@unique([requirementId, supplierOfferId])
  @@index([requirementId])
  @@map("source_allocations")
  @@index([result, selectedAt])
  @@schema("sourcing")
}

model AvailabilityActionRequirement {
  id                 String   @id @default(uuid()) @db.Uuid
  requirementId      String   @unique @map("requirement_id") @db.Uuid
  category           String   @db.VarChar(40)
  unresolvedQuantity Int      @map("unresolved_quantity")
  createdAt          DateTime @default(now()) @map("created_at")

  requirement SupplyRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@map("availability_action_requirements")
  @@schema("sourcing")
}

model SupplyPlanEvent {
  id              String           @id @default(uuid()) @db.Uuid
  supplyRequestId String           @map("supply_request_id") @db.Uuid
  status          SupplyPlanStatus
  createdAt       DateTime         @default(now()) @map("created_at")

  supplyRequest SupplyRequest @relation(fields: [supplyRequestId], references: [id], onDelete: Cascade)

  @@index([supplyRequestId, createdAt])
  @@map("supply_plan_events")
  @@schema("sourcing")
}

enum PurchaseOrderStatus {
  created
  sent
  reviewed
  expired
  confirmed
  partial
  ready
  received_at_hub

  @@schema("sourcing")
}

enum PurchaseOrderLineStatus {
  pending
  confirmed_full
  confirmed_partial
  unavailable
  /// The supplier cannot supply at the PO's approved unit cost (no quantity committed).
  price_changed

  @@schema("sourcing")
}

model SupplierPurchaseOrder {
  id         String              @id @default(uuid()) @db.Uuid
  supplierId String              @map("supplier_id") @db.Uuid
  status     PurchaseOrderStatus @default(created)
  notes      String?
  /// Procurement batch run that consolidated this PO (GLO-237); null for manual POs.
  batchRef   String?             @map("batch_ref") @db.VarChar(64)
  issuedAt   DateTime?           @map("issued_at")
  responseDeadlineAt DateTime?   @map("response_deadline_at")
  expedited Boolean             @default(false)
  openedAt   DateTime?           @map("opened_at")
  confirmedAt DateTime?          @map("confirmed_at")
  readyAt    DateTime?           @map("ready_at")
  receivedAt DateTime?           @map("received_at")
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  lines    PurchaseOrderLine[]
  payables SupplierPayable[]

  @@index([supplierId])
  @@index([batchRef])
  @@index([status, responseDeadlineAt])
  @@map("supplier_purchase_orders")
  @@schema("sourcing")
}

/// Supplier-confirmed units that did not reach the Hub, with where they were lost (GLO-243). Immutable.
model ReceivingShortfall {
  id         String   @id @default(uuid()) @db.Uuid
  linkId     String   @map("link_id") @db.Uuid
  quantity   Int
  /// NOT_HANDED_OVER (at supplier pickup) | LOST_IN_TRANSIT | SHORT_SHIPPED | DAMAGED_IN_TRANSIT
  reasonCode String   @map("reason_code") @db.VarChar(40)
  notes      String?
  actorId    String   @map("actor_id")
  createdAt  DateTime @default(now()) @map("created_at")

  link PurchaseOrderLineAllocation @relation(fields: [linkId], references: [id], onDelete: Restrict)

  @@index([linkId])
  @@map("receiving_shortfalls")
  @@schema("sourcing")
}

/// Quantity-aware N:1 lineage: each order-item allocation is supplied through exactly one PO line.
model PurchaseOrderLineAllocation {
  id                  String    @id @default(uuid()) @db.Uuid
  purchaseOrderLineId String    @map("purchase_order_line_id") @db.Uuid
  sourceAllocationId  String    @unique @map("source_allocation_id") @db.Uuid
  orderId             String    @map("order_id") @db.Uuid
  orderItemId         String    @map("order_item_id") @db.Uuid
  quantity            Int
  confirmedQuantity   Int?      @map("confirmed_quantity")
  receivedQuantity    Int       @default(0) @map("received_quantity")
  /// Confirmed units that will not arrive (recorded shortfalls; GLO-243).
  shortQuantity       Int       @default(0) @map("short_quantity")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  line             PurchaseOrderLine    @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  sourceAllocation SourceAllocation     @relation(fields: [sourceAllocationId], references: [id], onDelete: Restrict)
  shortfalls       ReceivingShortfall[]

  @@index([purchaseOrderLineId])
  @@index([orderId])
  @@map("purchase_order_line_allocations")
  @@schema("sourcing")
}

model PurchaseOrderLine {
  id                String                  @id @default(uuid()) @db.Uuid
  purchaseOrderId   String                  @map("purchase_order_id") @db.Uuid
  skuId             String                  @map("sku_id") @db.Uuid
  requestedQuantity Int                     @map("requested_quantity")
  confirmedQuantity Int?                    @map("confirmed_quantity")
  status            PurchaseOrderLineStatus @default(pending)
  /// Approved unit cost snapshot sent to the supplier; payables use this, never the live offer.
  unitCost          Decimal?                @map("unit_cost") @db.Decimal(10, 2)
  currency          String?                 @db.VarChar(3)
  supplierOfferId   String?                 @map("supplier_offer_id") @db.Uuid
  /// A partial confirmation shared by several orders waits for an explicit, audited distribution.
  distributionRequired Boolean              @default(false) @map("distribution_required")
  distributedBy     String?                 @map("distributed_by")
  distributedAt     DateTime?               @map("distributed_at")
  distributionReason String?                @map("distribution_reason")
  /// Supplier's typed reason when a line cannot be supplied as ordered (GLO-237 red team):
  /// MIN_ORDER_QUANTITY | PACK_SIZE | PRICE_CHANGED | OUT_OF_STOCK | DISCONTINUED
  exceptionCode      String?                 @map("exception_code") @db.VarChar(40)
  exceptionNote      String?                 @map("exception_note")
  proposedQuantity   Int?                    @map("proposed_quantity")
  proposedUnitCost   Decimal?                @map("proposed_unit_cost") @db.Decimal(10, 2)
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  purchaseOrder SupplierPurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  allocations   PurchaseOrderLineAllocation[]

  @@index([purchaseOrderId])
  @@index([skuId])
  @@map("purchase_order_lines")
  @@index([distributionRequired, createdAt])
  @@schema("sourcing")
}

enum PayableStatus {
  open
  ready_to_pay
  paid
  disputed
  adjusted

  @@schema("sourcing")
}

model SupplierPayable {
  id              String        @id @default(uuid()) @db.Uuid
  supplierId      String        @map("supplier_id") @db.Uuid
  purchaseOrderId String        @unique @map("purchase_order_id") @db.Uuid
  amount          Decimal       @db.Decimal(10, 2)
  /// Per-line quantity × approved unit cost snapshot the amount was computed from (GLO-238).
  basis           Json?
  currency        String        @db.VarChar(3)
  status          PayableStatus @default(open)
  dueDate         DateTime?     @map("due_date")
  paidAt          DateTime?     @map("paid_at")
  paymentRef      String?       @map("payment_ref")
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  supplier      Supplier              @relation(fields: [supplierId], references: [id])
  purchaseOrder SupplierPurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  adjustments   PayableAdjustment[]

  @@index([supplierId])
  @@map("supplier_payables")
  @@schema("sourcing")
}

model PayableAdjustment {
  id        String   @id @default(uuid()) @db.Uuid
  payableId String   @map("payable_id") @db.Uuid
  amount    Decimal  @db.Decimal(10, 2)
  reason    String
  actorId   String   @map("actor_id")
  createdAt DateTime @default(now()) @map("created_at")

  payable SupplierPayable @relation(fields: [payableId], references: [id], onDelete: Cascade)

  @@index([payableId])
  @@map("payable_adjustments")
  @@schema("sourcing")
}

// ---------------------------------------------------------------------------
// Ordering schema
// ---------------------------------------------------------------------------

model Cart {
  id             String   @id @default(uuid()) @db.Uuid
  // Exactly one owner: an authenticated customer, or an anonymous guest identified by an
  // opaque server-issued token (only its SHA-256 hash is stored; no PII).
  customerId     String?  @unique @map("customer_id") @db.Uuid
  guestTokenHash String?  @unique @map("guest_token_hash")
  revision       Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  items          CartItem[]
  checkoutQuotes CheckoutQuote[]

  @@map("carts")
  @@schema("ordering")
}

model CartItem {
  id              String    @id @default(uuid()) @db.Uuid
  cartId          String    @map("cart_id") @db.Uuid
  skuId           String    @map("sku_id") @db.Uuid
  quantity        Int
  // Transparency only: the price the customer saw when adding. Never pricing authority.
  priceAtAdd      Decimal?  @map("price_at_add") @db.Decimal(10, 2)
  priceObservedAt DateTime? @map("price_observed_at")
  // Lightweight provenance from a trusted flow (PDP | ROUTINE | REORDER). No lifecycle coupling.
  sourceType      String?   @map("source_type")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, skuId])
  @@index([cartId])
  @@index([skuId])
  @@map("cart_items")
  @@schema("ordering")
}

model CheckoutQuote {
  id         String    @id @default(uuid()) @db.Uuid
  cartId     String    @map("cart_id") @db.Uuid
  revision   Int
  snapshot   Json
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  orderId    String?   @unique @map("order_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")

  cart  Cart   @relation(fields: [cartId], references: [id], onDelete: Restrict)
  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([cartId, revision])
  @@map("checkout_quotes")
  @@schema("ordering")
}

enum OrderStatus {
  placed
  confirmed
  packing
  shipped
  delivered
  cancelled
  /// Left the hub but was never delivered and came back to sender (terminal, GLO-240).
  returned

  @@schema("ordering")
}

model Order {
  id                    String      @id @default(uuid()) @db.Uuid
  orderNumber           String      @unique @map("order_number")
  customerId            String?     @map("customer_id")
  customerName          String      @map("customer_name")
  customerPhone         String      @map("customer_phone")
  governorate           String?
  area                  String?
  shippingAddress       String      @map("shipping_address")
  notes                 String?
  latitude              Float?
  longitude             Float?
  locationSource        String?     @map("location_source")
  /// When the pin was confirmed (customer at checkout, or operator correction for legacy orders).
  locationConfirmedAt   DateTime?   @map("location_confirmed_at")
  /// 'customer' or the correcting operator's account id.
  locationConfirmedBy   String?     @map("location_confirmed_by")
  totalAmount           Decimal     @map("total_amount") @db.Decimal(10, 2)
  shippingFee           Decimal     @default(0) @map("shipping_fee") @db.Decimal(10, 2)
  currency              String      @db.VarChar(3)
  status                OrderStatus @default(placed)
  idempotencyKey        String?     @unique @map("idempotency_key")
  submissionHash        String?     @map("submission_hash")
  subtotal              Decimal?    @db.Decimal(10, 2)
  codAmount             Decimal?    @map("cod_amount") @db.Decimal(10, 2)
  deliveryPromise       String?     @map("delivery_promise")
  promisedDate          DateTime?   @map("promised_date") @db.Date
  availabilityCertainty String?     @map("availability_certainty")
  guestAccessTokenHash  String?     @unique @map("guest_access_token_hash")
  guestAccessExpiresAt  DateTime?   @map("guest_access_expires_at")
  guestAccessRevokedAt  DateTime?   @map("guest_access_revoked_at")
  appliedPromotions     Json?       @map("applied_promotions") // provenance for discounts/campaigns
  /// How the customer pays (GLO-241). Only COD creates driver cash; online methods need provider confirmation.
  paymentMethod         PaymentMethod @default(COD) @map("payment_method")
  /// Provider/product for online methods, e.g. a card PSP or 'vodafone_cash'.
  paymentProvider       String?     @map("payment_provider") @db.VarChar(40)
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  items                 OrderItem[]
  statusEvents          OrderStatusEvent[]
  checkoutQuote         CheckoutQuote?
  resolutions           OrderResolution[]
  paymentCollection     PaymentCollection?
  refundTransactions    RefundTransaction[]
  availabilityDecisions AvailabilityDecision[]
  amendments            OrderAmendment[]
  paymentAttempts       PaymentAttempt[]
  deliveryInstructions  DeliveryInstruction[]

  @@map("orders")
  @@schema("ordering")
}

/// Operator delivery instruction or corrected meeting point (RT08). Append-only: the customer's
/// confirmed pin and address on the order are never overwritten; drivers see both.
model DeliveryInstruction {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  note      String
  latitude  Float?
  longitude Float?
  reason    String   @db.VarChar(40)
  actorId   String   @map("actor_id")
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("delivery_instructions")
  @@schema("ordering")
}

model OrderStatusEvent {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @map("order_id") @db.Uuid
  status    OrderStatus
  createdAt DateTime    @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_events")
  @@schema("ordering")
}

model OrderItem {
  id                String             @id @default(uuid()) @db.Uuid
  orderId           String             @map("order_id") @db.Uuid
  skuId             String             @map("sku_id") @db.Uuid
  quantity          Int
  price             Decimal            @db.Decimal(10, 2)
  productId         String?            @map("product_id") @db.Uuid
  productName       String?            @map("product_name")
  skuCode           String?            @map("sku_code")
  variantName       String?            @map("variant_name")
  discountAmount    Decimal?           @map("discount_amount") @db.Decimal(10, 2)
  appliedPromotions Json?              @map("applied_promotions") // item-level provenance
  lineTotal         Decimal?           @map("line_total") @db.Decimal(10, 2)
  currency          String             @db.VarChar(3)
  lineState         OrderItemLineState @default(active) @map("line_state")
  replacesItemId    String?            @map("replaces_item_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  order       Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  resolutions OrderResolutionItem[]

  @@index([orderId])
  @@index([skuId])
  @@map("order_items")
  @@schema("ordering")
}

enum OrderItemLineState {
  active
  removed
  replaced

  @@schema("ordering")
}

enum AvailabilityDecisionStatus {
  pending
  resolved
  review_required
  superseded

  @@schema("ordering")
}

enum AvailabilityDecisionAction {
  REPLACE_WITH
  CONTINUE_WITHOUT_ITEM
  CANCEL_ORDER

  @@schema("ordering")
}

/// Ordering-owned customer decision for a Sourcing-reported availability shortage.
/// One pending decision per order item (partial unique index in migration).
model AvailabilityDecision {
  id                 String                      @id @default(uuid()) @db.Uuid
  orderId            String                      @map("order_id") @db.Uuid
  orderItemId        String                      @map("order_item_id") @db.Uuid
  version            Int                         @default(1)
  status             AvailabilityDecisionStatus  @default(pending)
  reasonCategory     String                      @map("reason_category") @db.VarChar(40)
  unresolvedQuantity Int                         @map("unresolved_quantity")
  originalSnapshot   Json                        @map("original_snapshot")
  candidates         Json
  availableActions   Json                        @map("available_actions")
  stateFingerprint   String                      @map("state_fingerprint")
  expiresAt          DateTime?                   @map("expires_at")
  decidedAction      AvailabilityDecisionAction? @map("decided_action")
  decidedSkuId       String?                     @map("decided_sku_id") @db.Uuid
  decidedBy          String?                     @map("decided_by")
  decidedChannel     String?                     @map("decided_channel") @db.VarChar(30)
  decidedAt          DateTime?                   @map("decided_at")
  decisionKey        String?                     @unique @map("decision_key")
  decisionHash       String?                     @map("decision_hash")
  receipt            Json?
  createdAt          DateTime                    @default(now()) @map("created_at")
  updatedAt          DateTime                    @updatedAt @map("updated_at")

  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amendment OrderAmendment?

  @@unique([orderItemId, version])
  @@index([orderId, status])
  @@map("availability_decisions")
  @@schema("ordering")
}

/// Append-only audit of an applied decision; the original order snapshot is never overwritten.
model OrderAmendment {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  decisionId String   @unique @map("decision_id") @db.Uuid
  type       String   @db.VarChar(40)
  before     Json
  after      Json
  codBefore  Decimal  @map("cod_before") @db.Decimal(10, 2)
  codAfter   Decimal  @map("cod_after") @db.Decimal(10, 2)
  currency   String   @db.VarChar(3)
  createdAt  DateTime @default(now()) @map("created_at")

  order    Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  decision AvailabilityDecision @relation(fields: [decisionId], references: [id])

  @@index([orderId])
  @@map("order_amendments")
  @@schema("ordering")
}

enum OrderResolutionType {
  cancellation
  return
  refund
  replacement
  compensation

  @@schema("ordering")
}

enum OrderResolutionStatus {
  requested
  approved
  rejected
  in_transit
  received
  resolved

  @@schema("ordering")
}

model OrderResolution {
  id                String                @id @default(uuid()) @db.Uuid
  orderId           String                @map("order_id") @db.Uuid
  type              OrderResolutionType
  status            OrderResolutionStatus @default(requested)
  reasonCode        String?               @map("reason_code")
  notes             String?
  resolutionDetails Json?                 @map("resolution_details")
  actorId           String                @map("actor_id")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  order             Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items             OrderResolutionItem[]
  events            OrderResolutionEvent[]
  refundTransaction RefundTransaction?

  @@index([orderId])
  @@map("order_resolutions")
  @@schema("ordering")
}

model OrderResolutionItem {
  id           String @id @default(uuid()) @db.Uuid
  resolutionId String @map("resolution_id") @db.Uuid
  orderItemId  String @map("order_item_id") @db.Uuid
  quantity     Int

  resolution OrderResolution @relation(fields: [resolutionId], references: [id], onDelete: Cascade)
  orderItem  OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([resolutionId, orderItemId])
  @@map("order_resolution_items")
  @@schema("ordering")
}

model OrderResolutionEvent {
  id           String                @id @default(uuid()) @db.Uuid
  resolutionId String                @map("resolution_id") @db.Uuid
  status       OrderResolutionStatus
  actorId      String                @map("actor_id")
  notes        String?
  createdAt    DateTime              @default(now()) @map("created_at")

  resolution OrderResolution @relation(fields: [resolutionId], references: [id], onDelete: Cascade)

  @@index([resolutionId])
  @@map("order_resolution_events")
  @@schema("ordering")
}

enum RefundStatus {
  pending
  processing
  succeeded
  failed

  @@schema("ordering")
}

model RefundTransaction {
  id              String       @id @default(uuid()) @db.Uuid
  resolutionId    String       @unique @map("resolution_id") @db.Uuid
  orderId         String       @map("order_id") @db.Uuid
  amount          Decimal      @db.Decimal(10, 2)
  currency        String       @db.VarChar(3)
  status          RefundStatus @default(pending)
  paymentProvider String?      @map("payment_provider")
  providerRef     String?      @map("provider_ref")
  errorReason     String?      @map("error_reason")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  resolution OrderResolution @relation(fields: [resolutionId], references: [id])
  order      Order           @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("refund_transactions")
  @@schema("ordering")
}

enum PaymentMethod {
  COD
  CARD
  MOBILE_WALLET

  @@schema("ordering")
}

enum PaymentAttemptStatus {
  pending
  confirmed
  failed

  @@schema("ordering")
}

/// An online payment attempt (GLO-241). Becomes `confirmed` only from a verified provider event;
/// at most one confirmed attempt per order (partial unique index). Card data is never stored.
model PaymentAttempt {
  id                    String               @id @default(uuid()) @db.Uuid
  orderId               String               @map("order_id") @db.Uuid
  method                PaymentMethod
  provider              String               @db.VarChar(40)
  /// Merchant reference sent to the provider; provider events refer to it.
  reference             String               @unique @db.VarChar(64)
  amount                Decimal              @db.Decimal(10, 2)
  currency              String               @db.VarChar(3)
  status                PaymentAttemptStatus @default(pending)
  providerTransactionId String?              @map("provider_transaction_id") @db.VarChar(128)
  failureReason         String?              @map("failure_reason")
  confirmedAt           DateTime?            @map("confirmed_at")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("payment_attempts")
  @@schema("ordering")
}

/// Every provider callback as received, deduplicated per provider event id (replays are harmless).
model PaymentProviderEvent {
  id              String   @id @default(uuid()) @db.Uuid
  provider        String   @db.VarChar(40)
  providerEventId String   @map("provider_event_id") @db.VarChar(128)
  type            String   @db.VarChar(40)
  reference       String?  @db.VarChar(64)
  /// applied | duplicate | ignored | rejected
  outcome         String   @db.VarChar(20)
  detail          String?
  payload         Json
  receivedAt      DateTime @default(now()) @map("received_at")

  @@unique([provider, providerEventId])
  @@map("payment_provider_events")
  @@schema("ordering")
}

enum SettlementStatus {
  expected
  collected
  settled
  short
  over
  disputed
  /// No cash is due any more (order cancelled or returned undelivered); the expectation is kept as a fact.
  voided

  @@schema("ordering")
}

model PaymentCollection {
  id                String           @id @default(uuid()) @db.Uuid
  orderId           String           @unique @map("order_id") @db.Uuid
  expectedAmount    Decimal          @map("expected_amount") @db.Decimal(10, 2)
  collectedAmount   Decimal?         @map("collected_amount") @db.Decimal(10, 2)
  /// Cash the delivering driver declared at the door (custody). Separate from the hub-counted collectedAmount.
  declaredAmount    Decimal?         @map("declared_amount") @db.Decimal(10, 2)
  declaredAt        DateTime?        @map("declared_at")
  currency          String           @db.VarChar(3)
  status            SettlementStatus @default(expected)
  courierId         String?          @map("courier_id")
  /// Hub whose run carried the cash (set at dispatch); settlement is counted at that hub (GLO-238).
  locationId        String?          @map("location_id") @db.Uuid
  settlementBatchId String?          @map("settlement_batch_id") @db.Uuid
  notes             String?
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  order           Order                   @relation(fields: [orderId], references: [id])
  settlementBatch CourierSettlementBatch? @relation(fields: [settlementBatchId], references: [id])

  @@map("payment_collections")
  @@schema("ordering")
}

model CourierSettlementBatch {
  id             String   @id @default(uuid()) @db.Uuid
  reference      String   @unique
  courierId      String   @map("courier_id")
  /// Hub where the cash was physically counted.
  locationId     String?  @map("location_id") @db.Uuid
  totalExpected  Decimal  @map("total_expected") @db.Decimal(10, 2)
  totalCollected Decimal  @map("total_collected") @db.Decimal(10, 2)
  fees           Decimal  @default(0) @db.Decimal(10, 2)
  netSettled     Decimal  @map("net_settled") @db.Decimal(10, 2)
  currency       String   @db.VarChar(3)
  settledAt      DateTime @default(now()) @map("settled_at")
  actorId        String   @map("actor_id")
  notes          String?

  collections PaymentCollection[]

  @@map("courier_settlement_batches")
  @@schema("ordering")
}

// ---------------------------------------------------------------------------
// Fulfillment schema
// ---------------------------------------------------------------------------

model FulfillmentLocation {
  id           String                  @id @default(uuid()) @db.Uuid
  name         String                  @unique
  address      String
  isActive     Boolean                 @default(true) @map("is_active")
  capabilities FulfillmentCapability[] @default([RECEIVE_SUPPLIER_GOODS, PREPARE_ORDERS, DISPATCH_SHIPMENTS, MANAGE_OWNED_INVENTORY])
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  shipments           Shipment[]
  inventoryBalances   InventoryBalance[]
  operatorAssignments FulfillmentLocationOperator[]
  receipts            FulfillmentReceipt[]
  deliveryBatches     DeliveryBatch[]

  @@map("fulfillment_locations")
  @@schema("fulfillment")
}

enum FulfillmentCapability {
  RECEIVE_SUPPLIER_GOODS
  PREPARE_ORDERS
  DISPATCH_SHIPMENTS
  MANAGE_OWNED_INVENTORY

  @@schema("fulfillment")
}

model FulfillmentLocationOperator {
  id         String   @id @default(uuid()) @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  operatorId String   @map("operator_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  location FulfillmentLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, operatorId])
  @@index([operatorId])
  @@map("fulfillment_location_operators")
  @@schema("fulfillment")
}

enum ShipmentStatus {
  pending
  ready_to_prepare
  preparing
  prepared
  ready_to_pack
  packing
  packed
  dispatched
  out_for_delivery
  delivered
  failed
  returned
  /// The order was cancelled before the package left the hub (GLO-240).
  cancelled

  @@schema("fulfillment")
}

model Shipment {
  id             String         @id @default(uuid()) @db.Uuid
  orderId        String         @unique @map("order_id") @db.Uuid
  locationId     String         @map("location_id") @db.Uuid
  status         ShipmentStatus @default(pending)
  trackingNumber String?        @map("tracking_number")
  dispatchedAt   DateTime?      @map("dispatched_at")
  deliveredAt    DateTime?      @map("delivered_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  location            FulfillmentLocation          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  items               ShipmentItem[]
  preparationSessions ShipmentPreparationSession[]
  events              ShipmentEvent[]
  deliveryStops       DeliveryStop[]

  @@index([locationId])
  @@map("shipments")
  @@schema("fulfillment")
}

model ShipmentItem {
  id         String   @id @default(uuid()) @db.Uuid
  shipmentId String   @map("shipment_id") @db.Uuid
  skuId      String   @map("sku_id") @db.Uuid
  quantity   Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([skuId])
  @@map("shipment_items")
  @@schema("fulfillment")
}

model DeliveryBatch {
  id           String    @id @default(uuid()) @db.Uuid
  status       String    @default("planning") // planning, dispatched, completed
  driverId     String?   @map("driver_id")
  /// Dispatching hub; null only on batches created before GLO-206 (admin-only access).
  locationId   String?   @map("location_id") @db.Uuid
  plannedAt    DateTime? @default(now()) @map("planned_at")
  dispatchedAt DateTime? @map("dispatched_at")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  location FulfillmentLocation? @relation(fields: [locationId], references: [id])
  stops    DeliveryStop[]

  @@index([locationId])
  @@index([driverId])
  @@map("delivery_batches")
  @@schema("fulfillment")
}

/// One delivery attempt of a shipment on a run. History is kept: a failed stop is closed and the
/// shipment can join a later run; at most one `active` stop per shipment (partial unique index).
model DeliveryStop {
  id         String    @id @default(uuid()) @db.Uuid
  batchId    String    @map("batch_id") @db.Uuid
  shipmentId String    @map("shipment_id") @db.Uuid
  sequence   Int
  /// active | delivered | failed | returned
  status     String    @default("active") @db.VarChar(20)
  closedAt   DateTime? @map("closed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  batch    DeliveryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  shipment Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@unique([batchId, sequence])
  @@index([shipmentId])
  @@map("delivery_stops")
  @@schema("fulfillment")
}

model ShipmentEvent {
  id         String   @id @default(uuid()) @db.Uuid
  shipmentId String   @map("shipment_id") @db.Uuid
  type       String // e.g. PACKED, LABEL_PRINTED, HANDOFF_SCANNED, OUT_FOR_DELIVERY, DELIVERED, FAILED, RETURNED
  actorId    String?  @map("actor_id") // ID of hub operator or driver
  /// Typed outcome reason, e.g. a failed attempt's cause (GLO-240).
  reasonCode String?  @map("reason_code") @db.VarChar(40)
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("shipment_events")
  @@schema("fulfillment")
}

model InventoryBalance {
  id                          String   @id @default(uuid()) @db.Uuid
  locationId                  String   @map("location_id") @db.Uuid
  skuId                       String   @map("sku_id") @db.Uuid
  ownedOnHand                 Int      @default(0) @map("owned_on_hand")
  reserved                    Int      @default(0)
  availableToSell             Int      @default(0) @map("available_to_sell")
  orderAllocatedExternalGoods Int      @default(0) @map("order_allocated_external_goods")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  location     FulfillmentLocation    @relation(fields: [locationId], references: [id])
  transactions InventoryTransaction[]

  @@unique([locationId, skuId])
  @@index([locationId])
  @@index([skuId])
  @@map("inventory_balances")
  @@schema("fulfillment")
}

model InventoryTransaction {
  id          String   @id @default(uuid()) @db.Uuid
  balanceId   String   @map("balance_id") @db.Uuid
  type        String // RECEIVE_OWNED, RESERVE, RELEASE, PICK, ADJUST, DAMAGE, RETURN_TO_STOCK
  quantity    Int
  reason      String?
  actorId     String?  @map("actor_id")
  referenceId String?  @map("reference_id") // OrderId, ShipmentId, etc
  createdAt   DateTime @default(now()) @map("created_at")

  balance InventoryBalance    @relation(fields: [balanceId], references: [id], onDelete: Cascade)
  receipt FulfillmentReceipt?

  @@index([balanceId])
  @@map("inventory_transactions")
  @@schema("fulfillment")
}

enum ReceivedGoodsCondition {
  ACCEPTABLE
  DAMAGED
  EXPIRED
  QUARANTINED

  @@schema("fulfillment")
}

model FulfillmentReceipt {
  id                          String                 @id @default(uuid()) @db.Uuid
  locationId                  String                 @map("location_id") @db.Uuid
  supplyRequestId             String                 @map("supply_request_id") @db.Uuid
  sourceAllocationId          String                 @map("source_allocation_id") @db.Uuid
  orderId                     String                 @map("order_id") @db.Uuid
  orderItemId                 String                 @map("order_item_id") @db.Uuid
  skuId                       String                 @map("sku_id") @db.Uuid
  variantName                 String                 @map("variant_name")
  quantity                    Int
  allocationConfirmedQuantity Int                    @map("allocation_confirmed_quantity")
  condition                   ReceivedGoodsCondition
  idempotencyKey              String                 @unique @map("idempotency_key") @db.VarChar(128)
  /// How the physical unit's identity was checked (GLO-242): primary_barcode | barcode_alias | manual
  identityMethod              String                 @default("unverified") @map("identity_method") @db.VarChar(20)
  barcodeScanned              String?                @map("barcode_scanned") @db.VarChar(64)
  identityNote                String?                @map("identity_note")
  /// Printed lot/batch and expiry when visible on the pack (evidence for later complaints; RT04).
  lotNumber                   String?                @map("lot_number") @db.VarChar(64)
  expiryDate                  DateTime?              @map("expiry_date") @db.Date
  actorId                     String                 @map("actor_id") @db.Uuid
  inventoryTransactionId      String                 @unique @map("inventory_transaction_id") @db.Uuid
  receivedAt                  DateTime               @default(now()) @map("received_at")

  location             FulfillmentLocation  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  inventoryTransaction InventoryTransaction @relation(fields: [inventoryTransactionId], references: [id], onDelete: Restrict)

  @@index([sourceAllocationId])
  @@index([orderId, orderItemId])
  @@index([locationId, skuId])
  @@map("fulfillment_receipts")
  @@schema("fulfillment")
}

enum PreparationSessionStatus {
  in_progress
  completed
  failed

  @@schema("fulfillment")
}

model ShipmentPreparationSession {
  id          String                   @id @default(uuid()) @db.Uuid
  shipmentId  String                   @map("shipment_id") @db.Uuid
  operatorId  String                   @map("operator_id") // Optional UUID or username representing the hub operator
  startedAt   DateTime                 @default(now()) @map("started_at")
  completedAt DateTime?                @map("completed_at")
  status      PreparationSessionStatus @default(in_progress)

  shipment   Shipment               @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  scanEvents PreparationScanEvent[]

  @@index([shipmentId])
  @@map("shipment_preparation_sessions")
  @@schema("fulfillment")
}

model PreparationScanEvent {
  id             String   @id @default(uuid()) @db.Uuid
  sessionId      String   @map("session_id") @db.Uuid
  skuId          String?  @map("sku_id") @db.Uuid
  barcodeScanned String?  @map("barcode_scanned")
  scannedAt      DateTime @default(now()) @map("scanned_at")
  isSuccessful   Boolean  @default(true) @map("is_successful")
  errorReason    String?  @map("error_reason")
  /// primary_barcode | barcode_alias | manual (GLO-242)
  verificationMethod String? @map("verification_method") @db.VarChar(20)
  operatorId     String?  @map("operator_id")
  manualReason   String?  @map("manual_reason")
  /// Client-generated id of one physical scan: a retried request returns the original (RT14).
  clientScanId   String?  @map("client_scan_id") @db.VarChar(64)

  session ShipmentPreparationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, clientScanId])
  @@index([sessionId])
  @@map("preparation_scan_events")
  @@schema("fulfillment")
}

// ---------------------------------------------------------------------------
// Ingestion schema (B6)
// ---------------------------------------------------------------------------

enum IngestionStatus {
  pending
  review_required
  approved
  rejected
  published

  @@schema("ingestion")
}

enum IngestionImportMode {
  FULL_SNAPSHOT
  PARTIAL_UPDATE

  @@schema("ingestion")
}

model IngestionJob {
  id                String              @id @default(uuid()) @db.Uuid
  supplierId        String              @map("supplier_id") @db.Uuid
  status            IngestionStatus     @default(pending)
  mode              IngestionImportMode @default(PARTIAL_UPDATE) @map("mode")
  sourceKey         String?             @map("source_key")
  sourceChecksum    String?             @map("source_checksum")
  /// Intake audit: who submitted the original and what was received (Gate 01).
  uploadedBy        String?             @map("uploaded_by")
  sourceFileName    String?             @map("source_file_name")
  sourceMimeType    String?             @map("source_mime_type")
  sourceSizeBytes   Int?                @map("source_size_bytes")
  /// Advisory provenance: server receipt time, workbook created/modified, declared document kind. Never trusted as freshness.
  sourceMetadata    Json?               @map("source_metadata")
  formatFingerprint String?             @map("format_fingerprint")
  profileId         String?             @map("profile_id") @db.Uuid
  rowOutcomes       Json?               @map("row_outcomes")
  eligibilityPolicyId String?           @map("eligibility_policy_id") @db.Uuid
  eligibilityPolicy IngestionEligibilityPolicy? @relation(fields: [eligibilityPolicyId], references: [id], onDelete: Restrict)
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  items         IngestionItem[]
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  exportProfile ExportProfile? @relation(fields: [profileId], references: [id])

  /// One job per identical supplier original; NULL checksums (JSON imports) stay unconstrained.
  @@unique([supplierId, sourceChecksum])
  @@index([supplierId])
  @@index([formatFingerprint])
  @@index([eligibilityPolicyId])
  @@map("ingestion_jobs")
  @@schema("ingestion")
}

/// Immutable approved snapshots. Preview records can only transition once to APPROVED.
model IngestionEligibilityPolicy {
  id String @id @default(uuid()) @db.Uuid
  version Int? @unique
  baseVersion Int @map("base_version")
  status String @default("PREVIEW")
  document Json
  impact Json
  actorId String @map("actor_id") @db.Uuid
  reason String
  createdAt DateTime @default(now()) @map("created_at")
  approvedAt DateTime? @map("approved_at")
  jobs IngestionJob[]
  @@index([status, version])
  @@map("eligibility_policies")
  @@schema("ingestion")
}

model ExportProfile {
  id                String    @id @default(uuid()) @db.Uuid
  supplierId        String    @map("supplier_id") @db.Uuid
  name              String
  formatFingerprint String    @map("format_fingerprint")
  version           Int       @default(1)
  isApproved        Boolean   @default(false) @map("is_approved")
  approvedBy        String?   @map("approved_by")
  approvedAt        DateTime? @map("approved_at")
  mapping           Json
  sampleHeaders     String[]  @map("sample_headers")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  supplier Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  jobs     IngestionJob[]

  @@unique([supplierId, formatFingerprint, version])
  @@index([supplierId])
  @@index([formatFingerprint])
  @@map("export_profiles")
  @@schema("ingestion")
}

enum IngestionItemEnrichmentStatus {
  pending
  succeeded
  failed

  @@schema("ingestion")
}

enum IngestionPriceType {
  PURCHASE_COST
  RETAIL_REFERENCE

  @@schema("ingestion")
}

model IngestionItem {
  id               String                        @id @default(uuid()) @db.Uuid
  jobId            String                        @map("job_id") @db.Uuid
  supplierSkuCode  String                        @map("supplier_sku_code")
  name             String
  brand            String
  barcode          String?
  price            Decimal                       @db.Decimal(10, 2)
  priceType        IngestionPriceType?           @map("price_type")
  reportedQuantity Int?                          @map("reported_quantity")
  currency         String                        @db.VarChar(3)
  status           IngestionStatus               @default(pending)
  matchedSkuId     String?                       @map("matched_sku_id") @db.Uuid
  enrichmentStatus IngestionItemEnrichmentStatus @default(pending) @map("enrichment_status")
  enrichment       Json?
  enrichmentError  String?                       @map("enrichment_error")
  createdAt        DateTime                      @default(now()) @map("created_at")
  updatedAt        DateTime                      @updatedAt @map("updated_at")

  job IngestionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  contentDraft ProductContentDraft?

  @@index([jobId])
  @@index([status])
  @@map("ingestion_items")
  @@schema("ingestion")
}

model ProductContentDraft {
  id               String   @id @default(uuid()) @db.Uuid
  candidateId      String   @unique @map("candidate_id") @db.Uuid
  language         String   @db.VarChar(5) // 'ar' or 'en'
  titleEn          String?
  titleAr          String?
  shortDescriptionEn String?
  shortDescriptionAr String?
  descriptionEn    String?
  descriptionAr    String?
  benefitsEn       String[]
  benefitsAr       String[]
  usageEn          String[]
  usageAr          String[]
  routineStepEn    String?
  routineStepAr    String?
  keywords         String[]
  seoTitleEn       String?
  seoTitleAr       String?
  seoDescriptionEn String?
  seoDescriptionAr String?
  evidenceVersion  String?
  modelVersion     String?
  isApproved       Boolean  @default(false) @map("is_approved")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  candidate IngestionItem @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("product_content_drafts")
  @@schema("ingestion")
}

model BrandDraft {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  canonicalName    String   @map("canonical_name")
  slug             String   @unique
  aliases          String[]
  descriptionEn    String?  @map("description_en")
  descriptionAr    String?  @map("description_ar")
  websiteUrl       String?  @map("website_url")
  countryOfOrigin  String?  @map("country_of_origin")
  logoUrl          String?  @map("logo_url")
  logoMetadata     Json?    @map("logo_metadata")
  status           String   @default("PENDING_REVIEW")
  rejectionReason  String?  @map("rejection_reason")
  reviewedBy       String?  @map("reviewed_by")
  reviewedAt       DateTime? @map("reviewed_at")
  evidence         Json?
  canonicalBrandId String?  @map("canonical_brand_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  productLines ProductLineDraft[]

  @@index([canonicalName])
  @@index([status])
  @@map("brand_drafts")
  @@schema("ingestion")
}

model ProductLineDraft {
  id              String   @id @default(uuid()) @db.Uuid
  brandDraftId    String   @map("brand_draft_id") @db.Uuid
  name            String
  slug            String
  descriptionEn   String?  @map("description_en")
  descriptionAr   String?  @map("description_ar")
  imageUrl        String?  @map("image_url")
  imageMetadata   Json?    @map("image_metadata")
  status          String   @default("PENDING_REVIEW")
  rejectionReason String?  @map("rejection_reason")
  canonicalLineId String?  @map("canonical_line_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  brandDraft BrandDraft @relation(fields: [brandDraftId], references: [id], onDelete: Cascade)

  @@unique([brandDraftId, slug])
  @@index([brandDraftId])
  @@map("product_line_drafts")
  @@schema("ingestion")
}

// ---------------------------------------------------------------------------
// Care schema
// ---------------------------------------------------------------------------

enum CareArea {
  skin
  hair

  @@schema("care")
}

enum RoutineTiming {
  am
  pm
  both
  as_needed

  @@schema("care")
}

model Concern {
  id          String                       @id @default(uuid()) @db.Uuid
  careArea    CareArea                     @map("care_area")
  name        String                       @unique
  slug        String                       @unique
  description String?
  isActive    Boolean                      @default(true) @map("is_active")
  createdAt   DateTime                     @default(now()) @map("created_at")
  updatedAt   DateTime                     @updatedAt @map("updated_at")
  profiles    CustomerCareProfileConcern[]

  @@map("concerns")
  @@schema("care")
}

model Routine {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?
  careArea    CareArea @map("care_area")
  isTemplate  Boolean  @default(true) @map("is_template")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  steps    RoutineStep[]
  profiles CustomerCareProfile[]

  @@map("routines")
  @@schema("care")
}

model RoutineStep {
  id           String        @id @default(uuid()) @db.Uuid
  routineId    String        @map("routine_id") @db.Uuid
  title        String
  instructions String?
  stepOrder    Int           @map("step_order")
  timing       RoutineTiming
  isOptional   Boolean       @default(false) @map("is_optional")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  routine         Routine                     @relation(fields: [routineId], references: [id], onDelete: Cascade)
  recommendations RoutineStepRecommendation[]

  @@unique([routineId, stepOrder])
  @@index([routineId])
  @@map("routine_steps")
  @@schema("care")
}

enum RecommendationSource {
  manual
  rule_engine
  ai
  expert

  @@schema("care")
}

model RoutineStepRecommendation {
  id        String               @id @default(uuid()) @db.Uuid
  stepId    String               @map("step_id") @db.Uuid
  productId String               @map("product_id") @db.Uuid
  source    RecommendationSource @default(manual)
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  step    RoutineStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([stepId, productId])
  @@index([stepId])
  @@index([productId])
  @@map("routine_step_recommendations")
  @@schema("care")
}

enum SkinType {
  normal
  dry
  oily
  combination
  sensitive

  @@schema("care")
}

model CustomerCareProfile {
  id            String    @id @default(uuid()) @db.Uuid
  customerId    String    @unique @map("customer_id")
  skinType      SkinType? @map("skin_type")
  budget        Decimal?  @db.Decimal(10, 2)
  currency      String?   @db.VarChar(3)
  sensitivities String?
  routineId     String?   @map("routine_id") @db.Uuid
  ageBand         CareAgeBand?         @map("age_band")
  experienceLevel CareExperienceLevel? @map("experience_level")
  fragranceFree   Boolean?             @map("fragrance_free")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  routine          Routine?                     @relation(fields: [routineId], references: [id])
  concerns         CustomerCareProfileConcern[]
  safetyFlags      CareSafetyFlags?
  customerRoutines CustomerRoutine[]

  @@index([routineId])
  @@map("customer_care_profiles")
  @@schema("care")
}

model CustomerCareProfileConcern {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  concernId String   @map("concern_id") @db.Uuid
  severity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  profile CustomerCareProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  concern Concern             @relation(fields: [concernId], references: [id], onDelete: Cascade)

  @@unique([profileId, concernId])
  @@index([profileId])
  @@index([concernId])
  @@map("customer_care_profile_concerns")
  @@schema("care")
}

enum GuidanceSessionStatus {
  active
  completed
  abandoned

  @@schema("care")
}

model GuidanceSession {
  id         String                @id @default(uuid()) @db.Uuid
  customerId String                @map("customer_id")
  status     GuidanceSessionStatus @default(active)
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  messages GuidanceMessage[]

  @@index([customerId])
  @@map("guidance_sessions")
  @@schema("care")
}

model RoutineDraft {
  id              String   @id @default(uuid()) @db.Uuid
  // Anonymous start with safe session ownership
  customerId      String?  @map("customer_id")
  guestTokenHash  String?  @unique @map("guest_token_hash")

  careArea        CareArea @default(skin) @map("care_area")
  primaryConcern  String?  @map("primary_concern")
  secondaryGoals  String[] @map("secondary_goals")
  budget          Decimal? @db.Decimal(10, 2)
  isBudgetStrict  Boolean  @default(false) @map("is_budget_strict")
  maxSteps        Int?     @map("max_steps")
  preferences     Json?    
  ownedProductIds String[] @map("owned_product_ids")

  /// 1 mild · 2 moderate · 3 severe (severe routes to the safety path, ROUTINE_SYSTEM.md §8).
  severity        Int?
  skinType        SkinType?            @map("skin_type")
  tier            RoutineTier?
  ageBand         CareAgeBand?         @map("age_band")
  experienceLevel CareExperienceLevel? @map("experience_level")
  fragranceFree   Boolean?             @map("fragrance_free")
  /// Safety answers for this draft only: { pregnant, breastfeeding, prescriptionTopical, oralRetinoid, fragranceSensitive }
  /// each YES | NO | UNKNOWN, plus pending flags for answers read from chat. Never free text.
  safety          Json?
  allergyIngredientIds String[]     @map("allergy_ingredient_ids")
  ownedRoleKeys   String[]          @map("owned_role_keys")
  /// Builder overrides replayed by the engine: { swaps: { roleKey: productId }, removed: roleKey[], upgrades: roleKey[] }
  overrides       Json?
  consentVersion  String?           @map("consent_version")
  consentAt       DateTime?         @map("consent_at")

  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  proposals       RoutineProposal[]
  
  @@index([customerId])
  @@map("routine_drafts")
  @@schema("care")
}

enum RoutineProposalStatus {
  proposed
  accepted
  rejected
  failed
  
  @@schema("care")
}

model RoutineProposal {
  id              String   @id @default(uuid()) @db.Uuid
  draftId         String   @map("draft_id") @db.Uuid
  status          RoutineProposalStatus @default(proposed)
  snapshot        Json
  totalPrice      Decimal? @map("total_price") @db.Decimal(10, 2)
  error           Json?    // Typed recoverable error state
  /// Draft version the engine ran on; only the proposal for the current draft version can be saved.
  draftVersion    Int?     @map("draft_version")
  engineVersion   String?  @map("engine_version")
  createdAt       DateTime @default(now()) @map("created_at")

  draft           RoutineDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
  @@map("routine_proposals")
  @@schema("care")
}

enum GuidanceMessageRole {
  user
  assistant
  system

  @@schema("care")
}

model GuidanceMessage {
  id        String              @id @default(uuid()) @db.Uuid
  sessionId String              @map("session_id") @db.Uuid
  role      GuidanceMessageRole
  content   String
  proposal  Json? // Store structured routine proposal if returned by AI
  createdAt DateTime            @default(now()) @map("created_at")

  session GuidanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("guidance_messages")
  @@schema("care")
}

// ---------------------------------------------------------------------------
// Routine system — phase 1, individual (docs/project/ROUTINE_SYSTEM.md)
// ---------------------------------------------------------------------------

enum CareAgeBand {
  UNDER_15
  AGE_15_17
  ADULT

  @@schema("care")
}

enum CareExperienceLevel {
  BEGINNER
  EXPERIENCED

  @@schema("care")
}

enum CareTriState {
  YES
  NO
  UNKNOWN

  @@schema("care")
}

enum RoutineTier {
  SMART
  COMPLETE
  LUXE

  @@schema("care")
}

enum RoutineKind {
  TREATMENT
  SUPPORT
  MAINTENANCE

  @@schema("care")
}

enum BlueprintStatus {
  DRAFT
  PUBLISHED
  RETIRED

  @@schema("care")
}

enum EligibilityReviewStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("care")
}

enum IngredientRuleKind {
  /// Both may be in one routine, applied at different times (e.g. benzoyl peroxide + tretinoin).
  SEPARATE_TIMES
  /// Explicitly compatible; recorded so the engine does not guess (e.g. benzoyl peroxide + adapalene).
  COMPATIBLE
  /// At most one product with the subject across all ACTIVE routines of one care area.
  MAX_ONE_PER_AREA
  /// The subject is excluded while the condition is YES or UNKNOWN.
  EXCLUDE_CONDITION

  @@schema("care")
}

enum IngredientRuleSubject {
  FAMILY
  INGREDIENT

  @@schema("care")
}

enum IngredientRuleStatus {
  ACTIVE
  DRAFT

  @@schema("care")
}

enum RoutineActivation {
  ACTIVE
  INACTIVE

  @@schema("care")
}

enum RoutineLifecycle {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  STOPPED

  @@schema("care")
}

enum RoutinePurchasePhase {
  IMMEDIATE
  DEFERRED

  @@schema("care")
}

/// The fixed structure of a routine for one concern and severity range. System data, published from admin only.
model RoutineBlueprint {
  id                 String          @id @default(uuid()) @db.Uuid
  key                String          @unique
  concernSlug        String          @map("concern_slug")
  careArea           CareArea        @map("care_area")
  kind               RoutineKind
  severityMin        Int             @default(1) @map("severity_min")
  severityMax        Int             @default(2) @map("severity_max")
  titleAr            String          @map("title_ar")
  titleEn            String          @map("title_en")
  goalAr             String?         @map("goal_ar")
  timelineAr         String?         @map("timeline_ar")
  safetyNotesAr      String[]        @map("safety_notes_ar")
  /// [{ title, url }] the rules and timeline come from; publishing requires at least one.
  sources            Json
  status             BlueprintStatus @default(DRAFT)
  version            Int             @default(1)
  publishedAt        DateTime?       @map("published_at")
  publishedBy        String?         @map("published_by")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  roles BlueprintRole[]

  @@index([concernSlug, status])
  @@map("routine_blueprints")
  @@schema("care")
}

/// One step of a blueprint, in application order. A role with required actives is a treatment role.
model BlueprintRole {
  id                     String  @id @default(uuid()) @db.Uuid
  blueprintId            String  @map("blueprint_id") @db.Uuid
  roleKey                String  @map("role_key")
  sortOrder              Int     @map("sort_order")
  titleAr                String  @map("title_ar")
  isEssential            Boolean @default(true) @map("is_essential")
  /// Week the step joins the routine (1 = from the start). Sunscreen is always 1.
  startWeek              Int     @default(1) @map("start_week")
  /// Ingredient family or ingredient slugs; a candidate needs one of them as a reviewed key active.
  requiredActives        String[] @map("required_actives")
  /// [{ subject, min, max, unit }]: the stated concentration must fall inside when the subject is the active used.
  concentrationRanges    Json?   @map("concentration_ranges")
  usageNoteAr            String? @map("usage_note_ar")

  blueprint RoutineBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@unique([blueprintId, roleKey])
  @@index([blueprintId])
  @@map("blueprint_roles")
  @@schema("care")
}

/// A product approved for a role. Approval comes from admin review; the engine never infers it.
model ProductRoleEligibility {
  id                String                  @id @default(uuid()) @db.Uuid
  productId         String                  @map("product_id") @db.Uuid
  roleKey           String                  @map("role_key")
  tier              RoutineTier
  concernSlugs      String[]                @map("concern_slugs")
  /// Empty = suitable for every skin type.
  suitableSkinTypes SkinType[]              @map("suitable_skin_types")
  reviewStatus      EligibilityReviewStatus @default(PENDING) @map("review_status")
  reviewedBy        String?                 @map("reviewed_by")
  reviewedAt        DateTime?               @map("reviewed_at")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  @@unique([productId, roleKey])
  @@index([roleKey, reviewStatus])
  @@map("product_role_eligibility")
  @@schema("care")
}

/// Compatibility and exclusion matrix (ROUTINE_SYSTEM.md §8-أ). Every row names its source.
model IngredientRule {
  id            String                @id @default(uuid()) @db.Uuid
  key           String                @unique
  kind          IngredientRuleKind
  subjectType   IngredientRuleSubject @map("subject_type")
  subject       String
  otherType     IngredientRuleSubject? @map("other_type")
  other         String?
  /// PREGNANT | BREASTFEEDING | ORAL_RETINOID | PRESCRIPTION_TOPICAL | AGE_UNDER_12 for EXCLUDE_CONDITION.
  condition     String?
  noteAr        String?               @map("note_ar")
  sourceTitle   String                @map("source_title")
  sourceUrl     String?               @map("source_url")
  /// PUBLISHED_GUIDANCE | STUDY | SHINACARE_POLICY (a conservative product rule, not a medical claim).
  sourceType    String                @map("source_type")
  status        IngredientRuleStatus  @default(ACTIVE)
  reviewedAt    DateTime              @default(now()) @map("reviewed_at")
  createdAt     DateTime              @default(now()) @map("created_at")

  @@index([kind, status])
  @@map("ingredient_rules")
  @@schema("care")
}

/// Safety answers of one care profile. Tri-state: UNKNOWN is never read as NO.
model CareSafetyFlags {
  id                   String       @id @default(uuid()) @db.Uuid
  careProfileId        String       @unique @map("care_profile_id") @db.Uuid
  pregnant             CareTriState @default(UNKNOWN)
  breastfeeding        CareTriState @default(UNKNOWN)
  prescriptionTopical  CareTriState @default(UNKNOWN) @map("prescription_topical")
  oralRetinoid         CareTriState @default(UNKNOWN) @map("oral_retinoid")
  fragranceSensitive   CareTriState @default(UNKNOWN) @map("fragrance_sensitive")
  allergyIngredientIds String[]     @map("allergy_ingredient_ids")
  consentVersion       String       @map("consent_version")
  consentAt            DateTime     @map("consent_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  careProfile CustomerCareProfile @relation(fields: [careProfileId], references: [id], onDelete: Cascade)

  @@map("care_safety_flags")
  @@schema("care")
}

/// A customer's saved routine. Activation and lifecycle are separate axes (ROUTINE_SYSTEM.md §5.6).
model CustomerRoutine {
  id                     String            @id @default(uuid()) @db.Uuid
  careProfileId          String            @map("care_profile_id") @db.Uuid
  blueprintId            String            @map("blueprint_id") @db.Uuid
  blueprintVersion       Int               @map("blueprint_version")
  concernSlug            String            @map("concern_slug")
  careArea               CareArea          @map("care_area")
  kind                   RoutineKind
  titleAr                String            @map("title_ar")
  tier                   RoutineTier?
  activation             RoutineActivation @default(INACTIVE)
  lifecycle              RoutineLifecycle  @default(NOT_STARTED)
  /// Why it is inactive or stopped, for the customer: COMPLETED | SEASON | CUSTOMER | SAFETY_IRRITATION | AREA_LIMIT ...
  statusReason           String?           @map("status_reason")
  version                Int               @default(1)
  budget                 Decimal?          @db.Decimal(10, 2)
  createdFromProposalId  String            @unique @map("created_from_proposal_id") @db.Uuid
  startedAt              DateTime?         @map("started_at")
  completedAt            DateTime?         @map("completed_at")
  stoppedAt              DateTime?         @map("stopped_at")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  careProfile CustomerCareProfile      @relation(fields: [careProfileId], references: [id], onDelete: Cascade)
  items       CustomerRoutineItem[]
  versions    CustomerRoutineVersion[]
  schedules   CustomerUsageSchedule[]

  @@index([careProfileId, activation])
  @@map("customer_routines")
  @@schema("care")
}

/// One step of a saved routine. Items are never edited in place: a change closes the item and adds a new one.
model CustomerRoutineItem {
  id                  String               @id @default(uuid()) @db.Uuid
  routineId           String               @map("routine_id") @db.Uuid
  roleKey             String               @map("role_key")
  sortOrder           Int                  @map("sort_order")
  isEssential         Boolean              @map("is_essential")
  productId           String?              @map("product_id") @db.Uuid
  skuId               String?              @map("sku_id") @db.Uuid
  tier                RoutineTier?
  isOwned             Boolean              @default(false) @map("is_owned")
  sharedWithRoutineId String?              @map("shared_with_routine_id") @db.Uuid
  purchasePhase       RoutinePurchasePhase @default(IMMEDIATE) @map("purchase_phase")
  startWeek           Int                  @default(1) @map("start_week")
  reasonCodes         String[]             @map("reason_codes")
  addedAtVersion      Int                  @map("added_at_version")
  removedAtVersion    Int?                 @map("removed_at_version")
  createdAt           DateTime             @default(now()) @map("created_at")

  routine CustomerRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@index([routineId, removedAtVersion])
  @@map("customer_routine_items")
  @@schema("care")
}

/// Frozen record of what the customer was told at one version: facts, usage, reasons, safety answers, rules.
model CustomerRoutineVersion {
  id        String   @id @default(uuid()) @db.Uuid
  routineId String   @map("routine_id") @db.Uuid
  version   Int
  snapshot  Json
  createdAt DateTime @default(now()) @map("created_at")

  routine CustomerRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@unique([routineId, version])
  @@map("customer_routine_versions")
  @@schema("care")
}

/// A personalized usage schedule entry for one product in a customer's routine (GLO-284 §5).
/// Represents the customer's confirmed weekly plan, derived from but independent of ProductUsageRule.
/// Supports ISO weekdays (1=Mon..7=Sun), morning/evening assignments, multi-phase schedules, and start dates.
model CustomerUsageSchedule {
  id                   String    @id @default(uuid()) @db.Uuid
  customerRoutineId    String    @map("customer_routine_id") @db.Uuid
  routineItemId        String    @map("routine_item_id") @db.Uuid
  productId            String    @map("product_id") @db.Uuid
  /// ISO weekdays when this product is used: 1=Mon, 2=Tue, ..., 7=Sun. Empty = every day.
  weekdays             Int[]     @default([])
  /// AM, PM, or BOTH for this schedule entry.
  timingSlot           UsageRoutinePeriod @default(BOTH) @map("timing_slot")
  /// Planned uses per occurrence (e.g. 1 application in the morning).
  plannedUsesPerOccurrence Int   @default(1) @map("planned_uses_per_occurrence")
  /// Phase number when the product has gradual escalation (1 = intro, 2 = ramp, 3 = full).
  phase                Int       @default(1)
  /// When this schedule entry takes effect.
  startDate            DateTime  @map("start_date") @db.Date
  /// When this schedule entry ends (null = open-ended / until next phase).
  endDate              DateTime? @map("end_date") @db.Date
  /// The ProductUsageRule this schedule was derived from (provenance link).
  sourceUsageRuleId    String?   @map("source_usage_rule_id") @db.Uuid
  /// Free-form notes from the customer or system about this schedule entry.
  notes                String?
  /// Whether the customer has confirmed this schedule entry.
  isConfirmed          Boolean   @default(false) @map("is_confirmed")
  /// Version of the routine when this schedule was created.
  routineVersion       Int       @map("routine_version")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  customerRoutine CustomerRoutine @relation(fields: [customerRoutineId], references: [id], onDelete: Cascade)

  @@unique([customerRoutineId, routineItemId, timingSlot, phase])
  @@index([customerRoutineId])
  @@index([productId])
  @@map("customer_usage_schedules")
  @@schema("care")
}

// ---------------------------------------------------------------------------
// Accounts schema
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
  HUB_OPERATOR
  SUPPLIER
  DRIVER

  @@schema("accounts")
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String   @unique
  roles     Role[]   @default([CUSTOMER])
  supplierId String? @map("supplier_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  identities Identity[]
  sessions   Session[]
  addresses  CustomerAddress[]
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([supplierId])
  @@map("customers")
  @@schema("accounts")
}

model Identity {
  id           String   @id @default(uuid()) @db.Uuid
  customerId   String   @map("customer_id") @db.Uuid
  provider     String // e.g., 'EMAIL', 'GOOGLE'
  providerId   String   @map("provider_id") // e.g., email address
  passwordHash String?  @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([customerId])
  @@map("identities")
  @@schema("accounts")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  token      String   @unique @db.Uuid
  isValid    Boolean  @default(true) @map("is_valid")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([token])
  @@map("sessions")
  @@schema("accounts")
}

model OtpChallenge {
  id            String   @id @default(uuid()) @db.Uuid
  phoneNumber   String   @map("phone_number")
  code          String
  purpose       String   @default("LOGIN")
  expiresAt     DateTime @map("expires_at")
  attempts      Int      @default(0)
  maxAttempts   Int      @default(3) @map("max_attempts")
  isUsed        Boolean  @default(false) @map("is_used")
  isRevoked     Boolean  @default(false) @map("is_revoked")
  pendingIntent String?  @map("pending_intent") // Stores returnTo or action intent
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([phoneNumber])
  @@map("otp_challenges")
  @@schema("accounts")
}

model CustomerAddress {
  id              String   @id @default(uuid()) @db.Uuid
  customerId      String   @map("customer_id") @db.Uuid
  label           String?
  customerName    String   @map("customer_name")
  customerPhone   String   @map("customer_phone")
  governorate     String
  area            String
  shippingAddress String   @map("shipping_address")
  notes           String?
  latitude        Float
  longitude       Float
  locationSource  String   @default("map_pin") @map("location_source")
  isDefault       Boolean  @default(false) @map("is_default")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
  @@schema("accounts")
}

// ---------------------------------------------------------------------------
// Operations schema
// ---------------------------------------------------------------------------

enum NotificationStatus {
  pending
  processing
  sent
  failed
  /// No delivery provider is connected for the channel: kept, never reported as sent (GLO-236).
  held

  @@schema("operations")
}

enum DomainEventStatus {
  pending
  processing
  delivered
  failed
  dead

  @@schema("operations")
}

/// Durable cross-module event delivery (transactional outbox/inbox, GLO-236). One row per
/// (event, aggregate, consumer), written in the producer's transaction; a dispatcher delivers it
/// with retries and the consumer handler must be idempotent.
model DomainEvent {
  id            String            @id @default(uuid()) @db.Uuid
  eventType     String            @map("event_type") @db.VarChar(80)
  aggregateType String            @map("aggregate_type") @db.VarChar(80)
  aggregateId   String            @map("aggregate_id") @db.Uuid
  consumer      String            @db.VarChar(80)
  payload       Json
  status        DomainEventStatus @default(pending)
  attempts      Int               @default(0)
  maxAttempts   Int               @default(8) @map("max_attempts")
  nextAttemptAt DateTime          @default(now()) @map("next_attempt_at")
  lockedUntil   DateTime?         @map("locked_until")
  lastError     String?           @map("last_error")
  deliveredAt   DateTime?         @map("delivered_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@unique([eventType, aggregateId, consumer])
  @@index([status, nextAttemptAt])
  @@index([aggregateId])
  @@map("domain_events")
  @@schema("operations")
}

model NotificationOutbox {
  id               String             @id @default(uuid()) @db.Uuid
  eventType        String             @map("event_type")
  aggregateId      String?            @map("aggregate_id")
  aggregateType    String?            @map("aggregate_type")
  customerId       String?            @map("customer_id")
  payload          Json
  channelIntent    String?            @map("channel_intent") // whatsapp, email, push
  templateId       String?            @map("template_id")
  templateVersion  Int?               @map("template_version")
  deduplicationKey String             @unique @map("deduplication_key")
  status           NotificationStatus @default(pending)
  attempts         Int                @default(0)
  maxAttempts      Int                @default(3) @map("max_attempts")
  nextAttemptAt    DateTime?          @map("next_attempt_at")
  lastError        Json?              @map("last_error")
  sentAt           DateTime?          @map("sent_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt])
  @@index([aggregateId, eventType])
  @@map("notification_outbox")
  @@schema("operations")
}

enum SupportCaseStatus {
  open
  in_progress
  resolved
  closed

  @@schema("operations")
}

enum SupportCasePriority {
  low
  medium
  high
  critical

  @@schema("operations")
}

enum SupportCaseCategory {
  payment
  sourcing
  delivery
  damaged_item
  wrong_item
  cancellation
  return
  supplier_dispute
  safety_concern
  other

  @@schema("operations")
}

model SupportCase {
  id          String              @id @default(uuid()) @db.Uuid
  title       String
  description String
  category    SupportCaseCategory @default(other)
  priority    SupportCasePriority @default(medium)
  status      SupportCaseStatus   @default(open)

  customerId String? @map("customer_id")
  orderId    String? @map("order_id") @db.Uuid
  supplierId String? @map("supplier_id") @db.Uuid

  assigneeId    String? @map("assignee_id")
  internalNotes String? @map("internal_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([assigneeId])
  @@map("support_cases")
  @@schema("operations")
}

enum AccountingExportStatus {
  pending
  processing
  completed
  failed

  @@schema("operations")
}

model AccountingExportJob {
  id        String                 @id @default(uuid()) @db.Uuid
  startDate DateTime               @map("start_date")
  endDate   DateTime               @map("end_date")
  status    AccountingExportStatus @default(pending)
  fileUrl   String?                @map("file_url")
  error     String?
  actorId   String                 @map("actor_id")
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")

  @@map("accounting_export_jobs")
  @@schema("operations")
}
