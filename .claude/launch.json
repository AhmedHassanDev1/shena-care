{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/api",
        "run",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/web",
        "run",
        "dev"
      ],
      "port": 3000,
      "env": {
        "NODE_OPTIONS": "--use-system-ca"
      }
    },
    {
      "name": "api-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/api",
        "run",
        "dev"
      ],
      "port": 3012,
      "env": {
        "DATABASE_URL": "postgresql://postgres@127.0.0.1:54432/shenacare_dev?connection_limit=5&connect_timeout=30",
        "PORT": "3012"
      },
      "autoPort": false
    },
    {
      "name": "web-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/web",
        "run",
        "dev",
        "--",
        "-p",
        "3020"
      ],
      "port": 3020,
      "autoPort": false,
      "env": {
        "NEXT_PUBLIC_API_URL": "http://localhost:3012"
      }
    }
  ]
}
