{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/api",
        "run",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/web",
        "run",
        "dev"
      ],
      "port": 3000,
      "env": {
        "NODE_OPTIONS": "--use-system-ca"
      }
    },
    {
      "name": "api-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/api",
        "run",
        "dev"
